                                 //
                                 /*SHOWS_LEDS:
                                 	MOV		TMP2,TMP
                                 	ANDI	TMP,1<<FREIO_D
                                 	BREQ	FREIO_BAIXO
                                 	SBI		PORTD,LED2					// ***** PLACEHOLDER PARA LED CORRESPONDENTE AO FREIO
                                 	RJMP	TESTA_ESQ
                                 FREIO_BAIXO:
                                 	CBI		PORTD,LED2
                                 TESTA_ESQ:
                                 	MOV		TMP,TMP2
                                 	ANDI	TMP,1<<ESQ_D
                                 	BREQ	ESQ_APAGADA
                                 ESQ_ACESA:
                                 	SBI		PORTD,LED1					// ***** PLACEHOLDER PARA LED CORRESPONDENTE À SETA ESQUERDA
                                 	RJMP	TESTA_DIR
                                 ESQ_APAGADA:
                                 	CBI		PORTD,LED1
                                 TESTA_DIR:
                                 	MOV		TMP,TMP2
                                 	ANDI	TMP,1<<DIR_D
                                 	BREQ	DIR_APAGADA
                                 DIR_ACESA:
                                 	SBI		PORTB,LED3					// ***** PLACEHOLDER PARA LED CORRESPONDENTE À SETA DIREITA
                                 	RJMP	FIM_LEDS
                                 DIR_APAGADA:
                                 	CBI		PORTB,LED3
                                 FIM_LEDS:
                                 	RET
                                 	*/
                                 // -----------------------------------------------------------------------------------------------
                                 //		FREQUENCIA A EXIBIR DEVE ESTAR SALVA EM TMP3:5 
                                 SHOWS_FREQ:	
0003ed e0b1
0003ee e4a0
0003ef dd97                      	POS_DEF	1,64
0003f0 e000                      	LDI		TMP,0
0003f1 d06e                      	RCALL	IMP_SEQ
0003f2 9508                      	RET
                                 
                                 // -----------------------------------------------------------------------------------------------
                                 //
                                 SHOWS_DATA:
                                 	// PRINTS DATA (ALREADY/TO BE) TRANSMITTED
0003f3 2733                      	CLR		TMP4	
0003f4 2f46                      	MOV		TMP5,DATA_OUT				// TMP5 = DATA_OUT
0003f5 e0b3
0003f6 e2a4
0003f7 dd8f                      	POS_DEF	3,36
0003f8 2700                      	CLR		TMP
0003f9 d05f                      	RCALL	IMP_SEQ3					// PRINTS DATA
                                 
                                 	// PRINTS LAST DATA RECEIVED
0003fa 2733                      	CLR		TMP4	
0003fb 2f47                      	MOV		TMP5,DATA_IN				// TMP5 = DATA_IN
0003fc e0b3
0003fd e5aa
0003fe dd88                      	POS_DEF	3,90
0003ff 2700                      	CLR		TMP
000400 d058                      	RCALL	IMP_SEQ3					// PRINTS DATA
                                 
                                 	// PRINTS SWITCHES STATUS
000401 2f4d                      	MOV		TMP5,SW_DATA
000402 e0b4
000403 e2a4
000404 dd82                      	POS_DEF	4,36
000405 2700                      	CLR		TMP							// DOES NOT PRINT DECIMAL SEPARATOR
000406 2733                      	CLR		TMP4						// CLEARS REGISTER AS VALUE IS NOT HIGHER THAN 255
000407 d051                      	RCALL	IMP_SEQ3					// PRINTS DATA	
                                 
                                 	// CONVERTS AND PRINTS BATTERY VOLTAGE
000408 e0b7
000409 e3ac
00040a dd7c                      	POS_DEF	7,60
00040b e5c5
00040c ddd0                      	P_CHAR	'U'							// PRINTS "UB:"
00040d e4c2
00040e ddce                      	P_CHAR	'B'
00040f e3ca
000410 ddcc                      	P_CHAR	':'
000411 2733                      	CLR		TMP4						// LOADS RESULTS IN TMP4:5
000412 2d47                      	MOV		TMP5,UBAT
000413 e2c0
000414 ddc8                      	P_CHAR	' '
000415 e001                      	LDI		TMP,1
000416 d042                      	RCALL	IMP_SEQ3					// PRINTS VOLTAGE (3 DIGITS, 1 TO THE RIGHT OF DECIMAL SEPARATOR)
000417 e2c0
000418 ddc4                      	P_CHAR	' '
000419 e5c6
00041a ddc2                      	P_CHAR	'V'
                                 
00041b fb90                      	BST		FL,MASTER					// STORES OPERATION MODE IN T BIT
00041c f5de                      	BRTC	SHOWS_S_DATA				// CHECKS IF T IS CLEAR (SLAVE MODE), IF SO, SHOWS DATA RELATED TO SLAVE MODE
                                 
                                 SHOWS_M_DATA:							// OTHERWISE (MASTER MODE), SHOWS DATA RELATED TO MASTER MODE
                                 	// PRINTS LEFT RAW DATA
00041d e0b6
00041e e0a0
00041f dd67                      	POS_DEF	6,0
000420 e4cc
000421 ddbb                      	P_CHAR	'L'							// PRINTS "L:"
000422 e3ca
000423 ddb9                      	P_CHAR	':'
000424 2733                      	CLR		TMP4						// CLEARS REGISTER AS VALUE IS NOT HIGHER THAN 255
000425 9140 0101                 	LDS		TMP5,AIN_LEFT				// TMP5 = LEFT RAW DATA
000427 e2c0
000428 ddb4                      	P_CHAR	' '
000429 2700                      	CLR		TMP
00042a d02e                      	RCALL	IMP_SEQ3					// PRINTS DATA
                                 
                                 	// PRINTS BRAKE RAW DATA
00042b e0b6
00042c e2ad
00042d dd59                      	POS_DEF	6,45
00042e e4c2
00042f ddad                      	P_CHAR	'B'							// PRINTS "B:"
000430 e3ca
000431 ddab                      	P_CHAR	':'
000432 2733                      	CLR		TMP4						// CLEARS REGISTER AS VALUE IS NOT HIGHER THAN 255
000433 9140 0105                 	LDS		TMP5,AIN_BRAKE				// TMP5 = BRAKE RAW DATA
000435 e2c0
000436 dda6                      	P_CHAR	' '
000437 2700                      	CLR		TMP
000438 d020                      	RCALL	IMP_SEQ3					// PRINTS DATA
                                 
                                 	// PRINTS RIGHT RAW DATA
000439 e0b6
00043a e5aa
00043b dd4b                      	POS_DEF	6,90
00043c e5c2
00043d dd9f                      	P_CHAR	'R'							// PRINTS "R:"
00043e e3ca
00043f dd9d                      	P_CHAR	':'
000440 2733                      	CLR		TMP4						// CLEARS REGISTER AS VALUE IS NOT HIGHER THAN 255
000441 9140 0100                 	LDS		TMP5,AIN_RIGHT				// TMP5 = RIGHT RAW DATA
000443 e2c0
000444 dd98                      	P_CHAR	' '
000445 2700                      	CLR		TMP
000446 d012                      	RCALL	IMP_SEQ3					// PRINTS DATA
                                 
                                 	// PRINTS LEVEL DETECTION RAW DATA
000447 e0b7
000448 e0a0
000449 dd3d                      	POS_DEF	7,0
00044a e4cc
00044b dd91                      	P_CHAR	'L'							// PRINTS "LD:"
00044c e4c4
00044d dd8f                      	P_CHAR	'D'
00044e e3ca
00044f dd8d                      	P_CHAR	':'
000450 2733                      	CLR		TMP4						// CLEARS REGISTER AS VALUE IS NOT HIGHER THAN 255
000451 9140 0102                 	LDS		TMP5,AIN_L_DET				// TMP5 = LEVEL DETECTION RAW DATA
000453 e2c0
000454 dd88                      	P_CHAR	' '
000455 2700                      	CLR		TMP
000456 d002                      	RCALL	IMP_SEQ3					// PRINTS DATA
000457 c000                      	RJMP	END_SHOWS_DATA
                                 
                                 SHOWS_S_DATA:
                                 	
                                 //	RJMP	END_SHOWS_DATA
                                 
                                 END_SHOWS_DATA:
000458 9508                      	RET
                                 
                                 
                                 
                                 // -----------------------------------------------------------------------------------------------
                                 //	TMP4:5 DEVEM SER PREVIAMENTE CARREGADOS COM VALOR A CONVERTER
                                 
                                 IMP_SEQ3:
000459 9488                      	CLC
00045a 3003                      	CPI		TMP,3
00045b f411                      	BRNE	GO_1K
00045c e2ce
00045d dd7f                      	P_CHAR	'.'						// PRINTS DECIMAL POINT
                                 GO_1K:
00045e e3c0                      	LDI		PAYLD,ZERO				// LIMPA CONTADOR DE SUBTRACOES (ACUMULADOR PARA DIGITO A SER IMPRESSO)
00045f c050                      	RJMP	_1K						// CALCULA APENAS OS TRES ULTIMOS DIGITOS
                                 	
                                 // -----------------------------------------------------------------------------------------------
                                 //	ROTINA PARA CONVERTER NUMERO DE 3 BYTES E IMPRIMIR
                                 //	TMP3:5 DEVEM SER PREVIAMENTE CARREGADOS COM VALOR A CONVERTER
                                 //	TMP2 CONTAINS THE POSITION TO PRINT DECIMAL SEPARATOR (7=TO THE LEFT OF ALL 7 DIGITS, 0=NOT TO BE PRINTED)
                                 
                                 IMP_SEQ:
000460 e3c0                      	LDI		PAYLD,ZERO
000461 3007                      	CPI		TMP,7
000462 f421                      	BRNE	_10M
000463 e2ce
000464 dd78                      	P_CHAR	'.'						// PRINTS DECIMAL POINT
000465 e3c0                      	LDI		PAYLD,ZERO
000466 9488                      	CLC
                                 _10M:
000467 95c3                      	INC		PAYLD					// INCREMENTA CONTADOR DE SUBTRACOES
000468 5440                      	SUBI	TMP5,LOW(1000000)		// SUBTRAI 1 000 000 DO NUMERO A SER MOSTRADO
000469 4432                      	SBCI	TMP4,BYTE2(1000000)
00046a 402f                      	SBCI	TMP3,BYTE3(1000000)
00046b f7d8                      	BRSH	_10M					// SE NUMERO' >= 0 CONTINUA SUBTRAINDO
                                 PREP_1M:
00046c 95ca                      	DEC		PAYLD					// NUMERO' < 0, DECREMENTA CONTADOR DE SUBTRACOES
00046d e450                      	LDI		TMP6,LOW(1000000)		// SOMA 1 000 000 NOVAMENTE PARA RETORNAR PARA VALOR NAO NEGATIVO
00046e 0f45                      	ADD		TMP5,TMP6
00046f e452                      	LDI		TMP6,BYTE2(1000000)
000470 1f35                      	ADC		TMP4,TMP6
000471 e05f                      	LDI		TMP6,BYTE3(1000000)
000472 1f25                      	ADC		TMP3,TMP6
000473 dd69                      	RCALL	CHAR6X8						// IMPRIME DIGITO
000474 e3c0                      	LDI		PAYLD,ZERO
000475 3006                      	CPI		TMP,6
000476 f419                      	BRNE	_1M
000477 e2ce
000478 dd64                      	P_CHAR	'.'						// PRINTS DECIMAL POINT
000479 e3c0                      	LDI		PAYLD,ZERO
                                 _1M:
00047a 95c3                      	INC		PAYLD					// INCREMENTA CONTADOR DE SUBTRACOES
00047b 5a40                      	SUBI	TMP5,LOW(100000)
00047c 4836                      	SBCI	TMP4,BYTE2(100000)
00047d 4021                      	SBCI	TMP3,BYTE3(100000)		// FAZ NUMERO - 100 000
00047e f7d8                      	BRSH	_1M						// SE NUMERO >= 0 CONTINUA SUBTRAINDO
                                 PREP_100K:
00047f 95ca                      	DEC		PAYLD					// NUMERO < 0, DECREMENTA CONTADOR DE SUBTRACOES
000480 ea50                      	LDI		TMP6,LOW(100000)		// SOMA 100 000 NOVAMENTE PARA RETORNAR PARA VALOR NAO NEGATIVO
000481 0f45                      	ADD		TMP5,TMP6
000482 e856                      	LDI		TMP6,BYTE2(100000)
000483 1f35                      	ADC		TMP4,TMP6
000484 e051                      	LDI		TMP6,BYTE3(100000)
000485 1f25                      	ADC		TMP3,TMP6
000486 dd56                      	RCALL	CHAR6X8						// IMPRIME DIGITO
000487 e3c0                      	LDI		PAYLD,ZERO
000488 3005                      	CPI		TMP,5
000489 f419                      	BRNE	_100K
00048a e2ce
00048b dd51                      	P_CHAR	'.'						// PRINTS DECIMAL POINT
00048c e3c0                      	LDI		PAYLD,ZERO
                                 _100K:
00048d 95c3                      	INC		PAYLD					// INCREMENTA CONTADOR DE SUBTRACOES
00048e 5140                      	SUBI	TMP5,LOW(10000)
00048f 4237                      	SBCI	TMP4,BYTE2(10000)		// FAZ NUMERO - 10 000
000490 4020                      	SBCI	TMP3,0
000491 f7d8                      	BRSH	_100K					// SE NUMERO >= 0 CONTINUA SUBTRAINDO
                                 PREP_10K:
000492 95ca                      	DEC		PAYLD					// NUMERO < 0, DECREMENTA CONTADOR DE SUBTRACOES
000493 e150                      	LDI		TMP6,LOW(10000)			// SOMA 10 000 NOVAMENTE PARA RETORNAR PARA VALOR NAO NEGATIVO
000494 0f45                      	ADD		TMP5,TMP6
000495 e257                      	LDI		TMP6,BYTE2(10000)
000496 1f35                      	ADC		TMP4,TMP6
000497 e050                      	LDI		TMP6,0
000498 1f22                      	ADC		TMP3,TMP3
000499 dd43                      	RCALL	CHAR6X8						// IMPRIME DIGITO
00049a e3c0                      	LDI		PAYLD,ZERO
00049b 3004                      	CPI		TMP,4
00049c f419                      	BRNE	_10K
00049d e2ce
00049e dd3e                      	P_CHAR	'.'						// PRINTS DECIMAL POINT
00049f e3c0                      	LDI		PAYLD,ZERO
                                 _10K:
0004a0 95c3                      	INC		PAYLD					// INCREMENTA CONTADOR DE SUBTRACOES
0004a1 5e48                      	SUBI	TMP5,LOW(1000)
0004a2 4033                      	SBCI	TMP4,BYTE2(1000)		// FAZ NUMERO - 1 000
0004a3 f7e0                      	BRSH	_10K					// SE NUMERO >= 0 CONTINUA SUBTRAINDO
                                 PREP_1K:
0004a4 95ca                      	DEC		PAYLD					// NUMERO < 0, DECREMENTA CONTADOR DE SUBTRACOES
0004a5 ee58                      	LDI		TMP6,LOW(1000)			// SOMA 1 000 NOVAMENTE PARA RETORNAR PARA VALOR NAO NEGATIVO
0004a6 0f45                      	ADD		TMP5,TMP6
0004a7 e053                      	LDI		TMP6,BYTE2(1000)
0004a8 1f35                      	ADC		TMP4,TMP6
0004a9 dd33                      	RCALL	CHAR6X8						// IMPRIME DIGITO
0004aa e3c0                      	LDI		PAYLD,ZERO
0004ab 3003                      	CPI		TMP,3
0004ac f419                      	BRNE	_1K
0004ad e2ce
0004ae dd2e                      	P_CHAR	'.'						// PRINTS DECIMAL POINT
0004af e3c0                      	LDI		PAYLD,ZERO
                                 _1K:
0004b0 95c3                      	INC		PAYLD					// INCREMENTA CONTADOR DE SUBTRACOES
0004b1 5644                      	SUBI	TMP5,100				// FAZ NUMERO - 100
0004b2 4030                      	SBCI	TMP4,0					// SUBTRAI APENAS O CARRY
0004b3 f7e0                      	BRSH	_1K						// SE NUMERO >= 0 CONTINUA SUBTRAINDO
                                 PREP_100:
0004b4 95ca                      	DEC		PAYLD					// NUMERO < 0, DECREMENTA CONTADOR DE SUBTRACOES
0004b5 e654                      	LDI		TMP6,100				// SOMA 100 NOVAMENTE PARA RETORNAR PARA VALOR NAO NEGATIVO
0004b6 0f45                      	ADD		TMP5,TMP6
0004b7 e050                      	LDI		TMP6,0
0004b8 1f35                      	ADC		TMP4,TMP6
0004b9 dd23                      	RCALL	CHAR6X8						// IMPRIME DIGITO
0004ba e3c0                      	LDI		PAYLD,ZERO
0004bb 3002                      	CPI		TMP,2
0004bc f419                      	BRNE	_100
0004bd e2ce
0004be dd1e                      	P_CHAR	'.'						// PRINTS DECIMAL POINT
0004bf e3c0                      	LDI		PAYLD,ZERO
                                 _100:
0004c0 95c3                      	INC		PAYLD					// INCREMENTA CONTADOR DE SUBTRACOES
0004c1 504a                      	SUBI	TMP5,10					// FAZ NUMERO - 10
0004c2 f7e8                      	BRSH	_100					// SE NUMERO >= 0 CONTINUA SUBTRAINDO
                                 PREP_10:
0004c3 95ca                      	DEC		PAYLD					// NUMERO < 0, DECREMENTA CONTADOR DE SUBTRACOES
0004c4 e05a                      	LDI		TMP6,10					// SOMA 10 NOVAMENTE PARA RETORNAR PARA VALOR NAO NEGATIVO
0004c5 0f45                      	ADD		TMP5,TMP6
0004c6 dd16                      	RCALL	CHAR6X8						// IMPRIME DIGITO
0004c7 e3c0                      	LDI		PAYLD,ZERO
0004c8 3001                      	CPI		TMP,1
0004c9 f419                      	BRNE	_10
0004ca e2ce
0004cb dd11                      	P_CHAR	'.'						// PRINTS DECIMAL POINT
0004cc e3c0                      	LDI		PAYLD,ZERO
                                 _10:
0004cd 95c3                      	INC		PAYLD					// INCREMENTA CONTADOR DE SUBTRACOES
0004ce 5041                      	SUBI	TMP5,1					// FAZ NUMERO - 1
0004cf f7e8                      	BRSH	_10						// SE NUMERO >= 0 CONTINUA SUBTRAINDO
                                 PREP_FIM:
0004d0 95ca                      	DEC		PAYLD					// NUMERO < 0, DECREMENTA CONTADOR DE SUBTRACOES
0004d1 e051                      	LDI		TMP6,1					// SOMA 1 NOVAMENTE PARA RETORNAR PARA VALOR NAO NEGATIVO
0004d2 0f45                      	ADD		TMP5,TMP6
0004d3 dd09                      	RCALL	CHAR6X8						// IMPRIME DIGITO
0004d4 9508                      	RET
                                 
                                 .INCLUDE "general.inc"
                                 
                                 /*	**********************************************************************************************
                                 	FELIPE LOPASSO RODRIGUES
                                 	********************************************************************************************** */
                                 
                                 
                                 
                                 
                                 
                                 
                                 // -----------------------------------------------------------------------------------------------
                                 //		LACO PRINCIPAL
                                 
                                 MAIN_LOOP:
                                 
                                 MAIN_LOOP2:
0004d5 d02f                      	RCALL	UPDATE_DOUT
                                 
0004d6 fd90                      	SBRC	FL,MASTER					// CHECKS IF BOARD OPERATES IN SLAVE MOVE, IF SO, SKIPS FREQUENCY UPDATE
0004d7 d002                      	RCALL	FREQ_AD
                                 
0004d8 df1a                      	RCALL	SHOWS_DATA					// PRINTS DATA SENT AND RECEIVED
                                 //	RCALL	BLINK
                                 
0004d9 cffb                      	RJMP	MAIN_LOOP2
                                 
                                 // -----------------------------------------------------------------------------------------------
                                 //		
                                 
                                 FREQ_AD:
0004da 9508                      RET
0004db fbd1                      	BST		SW_DATA,1
0004dc f01e                      	BRTS	INC_DEL
0004dd fbd2                      	BST		SW_DATA,2
0004de f056                      	BRTS	DEC_DEL
0004df c024                      	RJMP	END_F_ADJ
                                 INC_DEL:
0004e0 9110 0086                 	LDS		TMP2,ICR1L					// LOADS CURRENT TOP VALUE IN ICR1
0004e2 9100 0087                 	LDS		TMP,ICR1H
0004e4 2722                      	CLR		TMP3
0004e5 e031                      	LDI		TMP4,1
0004e6 1b13                      	SUB		TMP2,TMP4
0004e7 0b02                      	SBC		TMP,TMP3
                                 
0004e8 c008                      	RJMP	F_UPD
                                 
                                 DEC_DEL:
0004e9 9110 0086                 	LDS		TMP2,ICR1L					// LOADS CURRENT TOP VALUE IN ICR1
0004eb 9100 0087                 	LDS		TMP,ICR1H
0004ed 2722                      	CLR		TMP3
0004ee e031                      	LDI		TMP4,1
0004ef 0f13                      	ADD		TMP2,TMP4
0004f0 1f02                      	ADC		TMP,TMP3
                                 //RJMP	F_UPD
                                 
                                 F_UPD:
                                 // UPDATES TIMER 1
0004f1 9300 0087                 	STS		ICR1H,TMP					// (HIGH BYTE MUST BE WRITEN FIRST; READING MUST BE FIRST ON LOW BYTE)
0004f3 9310 0086                 	STS		ICR1L,TMP2
0004f5 9506                      	LSR		TMP							// DIVIDES VALUE BY 2 FOR DUTY = 50 %
0004f6 9517                      	ROR		TMP2
0004f7 9300 0089                 	STS		OCR1AH,TMP					// LOADS TOP/2 (DUTY) IN OCR1A AND OCR1B
0004f9 9310 0088                 	STS		OCR1AL,TMP2
0004fb 9300 008b                 	STS		OCR1BH,TMP			
0004fd 9310 008a                 	STS		OCR1BL,TMP2	
                                 // UPDATES DISPLAY
0004ff d01e                      	RCALL	FREQ_CALC					// CALCULATES CARRIER FREQUENCY BASED ON CURRENT ICR1(TOP) VALUE AND STORES IN SRAM (FREQ_H:FREQ_M:FREQ_L)
000500 2d26                      	MOV		TMP3,FREQ_H					// FREQ_PWM = FREQHZ/(1+TOP)
000501 2d35                      	MOV		TMP4,FREQ_M
000502 2d44                      	MOV		TMP5,FREQ_L
000503 dee9                      	RCALL	SHOWS_FREQ					// PRINTS FREQUENCY
                                 END_F_ADJ:
000504 9508                      	RET	
                                 
                                 
                                 // -----------------------------------------------------------------------------------------------
                                 //		UPDATES VALUE TO BE TRASMITTED
                                 
                                 UPDATE_DOUT:
000505 2f6d                      	MOV		DATA_OUT,SW_DATA
                                 //	SBR		FL,(1<<TX_RDY)
000506 9508                      	RET
                                 	
                                 // -----------------------------------------------------------------------------------------------
                                 //		LED BLINKER FOR DEBUG PURPOSE ~250 mS
                                 
                                 BLINK:
000507 9a28                      	SBI		PORTB,LED3
000508 e003                      	LDI		TMP,3
000509 d048                      	RCALL	DELAY_MS
00050a 9828                      	CBI		PORTB,LED3
00050b e10b                      	LDI		TMP,27
00050c d045                      	RCALL	DELAY_MS
00050d 9508                      	RET
                                 
                                 // --------------------------------
                                 MODE_DISP:
00050e e0b2
00050f e0a0
000510 dc76                      	POS_DEF	2, 0
000511 e4c6
000512 dcca                      	P_CHAR	'F'
000513 e3c0
000514 dcc8                      	P_CHAR	'0'
000515 e3ca
000516 dcc6                      	P_CHAR	':'
000517 e2c0
000518 dcc4                      	P_CHAR	' '
000519 2f49                      	MOV		TMP5,FL
00051a 2700                      	CLR		TMP							// DOES NOT PRINT DECIMAL SEPARATOR
00051b 2733                      	CLR		TMP4						// CLEARS REGISTER AS VALUE IS NOT HIGHER THAN 255
00051c df3c                      	RCALL	IMP_SEQ3					// PRINTS DATA
00051d 9508                      	RET
                                 
                                 
                                 
                                 // -----------------------------------------------------------------------------------------------
                                 //		CALCULATES CARRIER FREQUENCY TO DISPLAY
                                 
                                 FREQ_CALC:
00051e e000                      	LDI		TMP,LOW(FREQHZ)				// LOADS DIVIDEND = FREQHZ
00051f 2e80                      	MOV		DDRT0,TMP
000520 e20d                      	LDI		TMP,BYTE2(FREQHZ)
000521 2e90                      	MOV		DDRT1,TMP
000522 e301                      	LDI		TMP,BYTE3(FREQHZ)
000523 2ea0                      	MOV		DDRT2,TMP
000524 e001                      	LDI		TMP,BYTE4(FREQHZ)
000525 2eb0                      	MOV		DDRT3,TMP
000526 24cc                      	CLR		DVRS0						// LOADS DIVISOR (DIVISOR = 1 + TOP; FIRST STEP: LOADS 1 @ LOW BYTE, 0 @ HIGH BYTE)
000527 24dd                      	CLR		DVRS1	
000528 94c3                      	INC		DVRS0
000529 9110 0086                 	LDS		TMP2,ICR1L					// LOADS CURRENT TOP VALUE IN TMP2:TMP
00052b 9100 0087                 	LDS		TMP,ICR1H
00052d 0ec1                      	ADD		DVRS0,TMP2					// SUMS TOP TO VALUE STORED IN DIVISOR (DIVISOR = 1 + TOP)
00052e 1ed0                      	ADC		DVRS1,TMP
00052f d04c                      	RCALL	udiv32_16					// DIVIDES FREQHZ / (1 + TOP), STORES RESULT IN DDRT0, DDRT1, DDRT2
000530 2c48                      	MOV		FREQ_L,DDRT0				// STORES RESULTS IN SRAM
000531 2c59                      	MOV		FREQ_M,DDRT1
000532 2c6a                      	MOV		FREQ_H,DDRT2
000533 9508                      	RET
                                 
                                 .INCLUDE "delays.inc"
                                 
                                 
                                 	DELAYS PARA USO GERAL
                                 	FELIPE LOPASSO RODRIGUES - 12/12/2009
                                 
                                 	DEFINIÇÕES EXTERNAS NECESSÁRIAS PARA USO DAS SUBROTINAS:
                                 
                                 // *** CONSTANTES ***
                                 	FREQ -> VALOR DA FREQUÊNCIA DO MICROCONTROLADOR, DE 1 A 20, APENAS INTEIROS
                                 
                                 // *** REGISTRADORES ***
                                 	TMP -> PARÂMETRO PARA O VALOR DO DELAY EM mS					>R16
                                 	TMP2, TMP3	->	REGISTRADORES USADOS DENTRO DA ROTINA	>R16
                                 
                                 ******************************************************************************* */
                                 
                                 // *******************************************************************************
                                 //		DELAY DE 1 A 255 s
                                 
                                 DELAY_S:
000534 930f                      	PUSH	TMP
000535 931f                      	PUSH	TMP2		// SALVA CONTEUDO DE TMP2
000536 2f10                      	MOV		TMP2,TMP
                                 
000537 3000                      	CPI		TMP,0
000538 f051                      	BREQ	NODEL1S
                                 
                                 DEL_1S:
000539 ef0a                      	LDI		TMP,250		// FAZ DELAY DE 1 s
00053a d017                      	RCALL	DELAY_MS
00053b ef0a                      	LDI		TMP,250
00053c d015                      	RCALL	DELAY_MS
00053d ef0a                      	LDI		TMP,250
00053e d013                      	RCALL	DELAY_MS
00053f ef0a                      	LDI		TMP,250
000540 d011                      	RCALL	DELAY_MS
                                 
000541 951a                      	DEC		TMP2		// DECREMENTA CONTADOR DE SEGUNDOS
000542 f7b1                      	BRNE	DEL_1S		// SE NAO CHEGOU A 0, CONTINUA DELAY
                                 NODEL1S:
000543 911f                      	POP		TMP2		// RECUPERA CONTEUDO DE TMP2
000544 910f                      	POP		TMP
000545 9508                      	RET
                                 
                                 // *******************************************************************************
                                 //		DELAY DE 10 ms A 2550 ms
                                 
                                 DELAY_DS:
000546 931f                      	PUSH	TMP2		// SALVA CONTEUDO DE TMP2
000547 930f                      	PUSH	TMP
                                 
000548 3000                      	CPI		TMP,0
000549 f029                      	BREQ	NODELDS
00054a 2f10                      	MOV		TMP2,TMP
                                 DEL_10MS:
00054b e00a                      	LDI		TMP,10		// FAZ DELAY DE 10 ms
00054c d005                      	RCALL	DELAY_MS
                                 
00054d 951a                      	DEC		TMP2		// DECREMENTA CONTADOR DE SEGUNDOS
00054e f7e1                      	BRNE	DEL_10MS	// SE NAO CHEGOU A 0, CONTINUA DELAY
                                 NODELDS:
00054f 910f                      	POP		TMP
000550 911f                      	POP		TMP2		// RECUPERA CONTEUDO DE TMP2
000551 9508                      	RET
                                 // *******************************************************************************
                                 //		DELAY DE 1 A 250 mS; ERRO MÁXIMO = 1.7 % (1 mS @ 1 MHz)
                                 //		NUM_INST = 	(1000*FREQ + 3)*[TMP] + 16 (CONSIDERANDO RCALL DELAY_MS E RET)
                                 //		NAO ALTERA O VALOR DE REGISTRADORES
                                 
                                 DELAY_MS:
000552 930f                      	PUSH	TMP
000553 931f                      	PUSH	TMP2			// SALVA REGISTRADORES
000554 932f                      	PUSH	TMP3
                                 
000555 3000                      	CPI		TMP,0
000556 f051                      	BREQ	NODELMS
                                 DEL_1_MS:					// 1 mS = 1000*FREQ = (996 + 4)*FREQ (BRNE(FALSE) COMPENSA O LDI)
000557 e114                      	LDI		TMP2,FREQ		
                                 
                                 MAIS_996_INST:				// 996 = 249*4 (BRNE(FALSE) COMPENSA O LDI)
000558 ef29                      	LDI		TMP3,249
                                 
                                 QUATRO_INST:				// NOP + DEC + BRNE(TRUE) = 4
000559 0000                      	NOP
00055a 952a                      	DEC		TMP3
00055b f7e9                      	BRNE	QUATRO_INST		// VERIFICA SE JÁ FEZ 249 ITERAÇÕES DE 4 INSTRUCOES
                                 
00055c 0000                      	NOP
00055d 951a                      	DEC		TMP2
00055e f7c9                      	BRNE	MAIS_996_INST	// VERIFICA SE JÁ FEZ "FREQ" ITERAÇÕES DE 1000 INSTRUCOES
                                 
00055f 950a                      	DEC		TMP
000560 f7b1                      	BRNE	DEL_1_MS		// VERIFICA SE JÁ FEZ "TMP" ITERAÇÕES DE 1 mS
                                 NODELMS:
000561 912f                      	POP		TMP3			// RESTAURA REGISTRADORES
000562 911f                      	POP		TMP2
000563 910f                      	POP		TMP
000564 9508                      	RET						// RETORNA
                                 
                                 // *******************************************************************************
                                 //		DELAY DE 100 A 2500 us; ERRO MÁXIMO = ?
                                 //		NUM_INST = 	(1000*FREQ + 3)*[TMP] + 14 (CONSIDERANDO RCALL DEL100_US E RET)
                                 //		NAO ALTERA O VALOR DE REGISTRADORES
                                 
                                 DEL100_US:
000565 930f                      	PUSH	TMP
000566 931f                      	PUSH	TMP2			// SALVA REGISTRADORES
000567 932f                      	PUSH	TMP3
                                 
                                 DEL_100_US:					// 100 uS = 100*FREQ INSTRUCOES = (96 + 4)*FREQ (BRNE(FALSE) COMPENSA O LDI) (1/FREQ)
000568 e114                      	LDI		TMP2,FREQ		
                                 
                                 MAIS_96_INST:				// 96 = 24*4 (BRNE(FALSE) COMPENSA O LDI)
000569 e128                      	LDI		TMP3,24
                                 
                                 Q_INST:						// NOP + DEC + BRNE(TRUE) = 4
00056a 0000                      	NOP
00056b 952a                      	DEC		TMP3
00056c f7e9                      	BRNE	Q_INST			// VERIFICA SE JÁ FEZ 24 ITERAÇÕES DE 4 INSTRUCOES
                                 
00056d 0000                      	NOP
00056e 951a                      	DEC		TMP2
00056f f7c9                      	BRNE	MAIS_96_INST	// VERIFICA SE JÁ FEZ "FREQ" ITERAÇÕES DE 100 INSTRUCOES
                                 
000570 950a                      	DEC		TMP
000571 f7b1                      	BRNE	DEL_100_US		// VERIFICA SE JÁ FEZ "R16" ITERAÇÕES DE 100 uS
                                 
000572 912f                      	POP		TMP3			// RESTAURA REGISTRADORES
000573 911f                      	POP		TMP2
000574 910f                      	POP		TMP
000575 9508                      	RET						// RETORNA
                                 
                                 // -------------------------------------------------------------------------------
                                 //		DELAY DE 5 uS @ 12/4 MHz
                                 
                                 
                                 //	P/ 12 MHZ
                                 							// NUMERO DE INSTRUCOES
                                 DEL_5_US:					//	3
                                 //RET
000576 930f                      	PUSH	TMP				//	2
000577 e006                      	LDI		TMP,6			//	1
                                 DEL_5_DEC:
000578 950a                      	DEC		TMP				//	1
000579 f7f1                      	BRNE	DEL_5_DEC		//	2
                                 
00057a 910f                      	POP		TMP				//	2
00057b 9508                      	RET						//	4
                                 
                                 
                                 /*	P/ 4 MHZ
                                 							// NUMERO DE INSTRUCOES
                                 DEL_5_US:					//	3
                                 	PUSH	TMP2			//	2
                                 	LDI		TMP2,2			//	1
                                 DEL_5_DEC:
                                 	DEC		TMP2			//	1
                                 	BRNE	DEL_5_DEC		//	2
                                 
                                 	POP		TMP2			//	2
                                 	RET						//	4
                                 */	
                                 
                                 
                                 .INCLUDE "div88.inc"
                                 
                                 ;*                                                                      *
                                 ;*                      unsigned division 24 / 16 bit                   *
                                 ;*              Author: Peter Dannegger                                 *
                                 ;*                                                                      *
                                 ;************************************************************************
                                 ;
                                 //.def		DDRT0		=			// DIVIDENDO E RESULTADO
                                 //.def		DDRT1		=			// DIVIDENDO E RESULTADO
                                 //.def		DDRT2		=			// DIVIDENDO E RESULTADO	
                                 //.def		DVRS0		=			// DIVISOR E RESTO
                                 //.def		DVRS1		=			// DIVISOR E RESTO
                                 //.def		TMP			=			// TEMPORARIO
                                 //.def		TMP2		=			// TEMPORARIO
                                 //.def		TMP3		=			// TEMPORARIO
                                 /*
                                 udiv24_16:
                                 	clr     TMP
                                 	clr     TMP2
                                 	ldi     TMP3, 24
                                 _udi1:
                                 	lsl     DDRT0
                                 	rol     DDRT1
                                 	rol     DDRT2
                                 	rol     TMP
                                 	rol     TMP2
                                 	brcs    _udi2           ; handle carry (e.g. 0x10000 / 0xFFFF) !
                                 	cp      TMP, DVRS0
                                 	cpc     TMP2, DVRS1
                                 	brcs    _udi3
                                 _udi2:
                                 	sub     TMP, DVRS0
                                 	sbc     TMP2, DVRS1
                                 	inc     DDRT0
                                 _udi3:
                                 	dec     TMP3
                                 	brne    _udi1
                                 	mov     DVRS0, TMP
                                 	mov     DVRS1, TMP2
                                 	ret
                                 */
                                 
                                 ;***************************************************************************
                                 ;*
                                 ;* "mpy16u" - 16x16 Bit Unsigned Multiplication
                                 ;*
                                 ;* This subroutine multiplies the two 16-bit register variables 
                                 ;* mp16uH:mp16uL and mc16uH:mc16uL.
                                 ;* The result is placed in m16u3:m16u2:m16u1:m16u0.
                                 ;*  
                                 ;* Number of words	:14 + return
                                 ;* Number of cycles	:153 + return
                                 ;* Low registers used	:None
                                 ;* High registers used  :7 (mp16uL,mp16uH,mc16uL/m16u0,mc16uH/m16u1,m16u2,
                                 ;*                          m16u3,mcnt16u)	
                                 ;*
                                 ;***************************************************************************
                                 
                                 ;***** Subroutine Register Variables
                                 
                                 //.def	mc16uL	=r16		;multiplicand low byte
                                 //.def	mc16uH	=r17		;multiplicand high byte
                                 //.def	mp16uL	=r18		;multiplier low byte
                                 //.def	mp16uH	=r19		;multiplier high byte
                                 //.def	m16u0	=r18		;result byte 0 (LSB)
                                 //.def	m16u1	=r19		;result byte 1
                                 //.def	m16u2	=r20		;result byte 2
                                 //.def	m16u3	=r21		;result byte 3 (MSB)
                                 //.def	mcnt16u	=r22		;loop counter
                                 
                                 ;***** Code
                                 /*
                                 mpy16u:	
                                 	clr		m16u3			;clear 2 highest bytes of result
                                 	clr		m16u2
                                 	ldi		mcnt16u,16		;init loop counter
                                 	lsr		mp16uH
                                 	ror		mp16uL
                                 
                                 m16u_1:	
                                 	brcc	noad8			;if bit 0 of multiplier set
                                 	add		m16u2,mc16uL	;add multiplicand Low to byte 2 of res
                                 	adc		m16u3,mc16uH	;add multiplicand high to byte 3 of res
                                 noad8:	
                                 	ror		m16u3			;shift right result byte 3
                                 	ror		m16u2			;rotate right result byte 2
                                 	ror		m16u1			;rotate result byte 1 and multiplier High
                                 	ror		m16u0			;rotate result byte 0 and multiplier Low
                                 	dec		mcnt16u			;decrement loop counter
                                 	brne	m16u_1			;if not done, loop more
                                 	ret
                                 
                                 	*/
                                 
                                 ;************************************************************************
                                 ;*                                                                      *
                                 ;*              unsigned division 32 / 16 bit                           *
                                 ;*              based on Peter Dannegger's code                         *
                                 ;*                                                                      *
                                 ;************************************************************************
                                 ;
                                 //.def		DDRT0		=			// DIVIDENDO E RESULTADO
                                 //.def		DDRT1		=			// DIVIDENDO E RESULTADO
                                 //.def		DDRT2		=			// DIVIDENDO E RESULTADO
                                 //.def		DDRT3		=			// DIVIDENDO E RESULTADO	
                                 //.def		DVRS0		=			// DIVISOR E RESTO
                                 //.def		DVRS1		=			// DIVISOR E RESTO
                                 //.def		TMP			=			// TEMPORARIO
                                 //.def		TMP2		=			// TEMPORARIO
                                 //.def		TMP3		=			// TEMPORARIO
                                 //.def		TMP4		=			// TEMPORARIO
                                 
                                 udiv32_16:
00057c 2700                      	clr     TMP
00057d 2711                      	clr     TMP2
00057e 2722                      	CLR		TMP3
00057f e230                      	ldi     TMP4, 32
                                 _udi1:
000580 0c88                      	lsl     DDRT0
000581 1c99                      	rol     DDRT1
000582 1caa                      	rol     DDRT2
000583 1cbb                      	ROL		DDRT3
000584 1f00                      	rol     TMP
000585 1f11                      	rol     TMP2
000586 f018                      	brcs    _udi2           ; handle carry (e.g. 0x10000 / 0xFFFF) !      PULA PARA _udi2 QUANDO ACONTECER OVERFLOW EM TMP2
000587 150c                      	cp      TMP, DVRS0
000588 051d                      	cpc     TMP2, DVRS1	
000589 f018                      	brcs    _udi3			
                                 _udi2:
00058a 190c                      	sub     TMP, DVRS0		// DECREMENTA DIVIDENDO EM MULTIPLOS DE DIVISOR, INCREMENTA RESULTADO
00058b 091d                      	sbc     TMP2, DVRS1
00058c 9483                      	inc     DDRT0
                                 _udi3:	
00058d 953a                      	dec     TMP4			// DECREMENTA INDICADOR DE BIT
00058e f789                      	brne    _udi1
00058f 2ec0                      	mov     DVRS0, TMP		// CARREGA RESTO EM DVSR0
000590 2ed1                      	mov     DVRS1, TMP2
                                 .include "hwconfig.inc"
000591 9508                      
                                 // -----------------------------------------------------------------------------------------------
                                 //		DEFINES COMMON HW SETTINGS FOR MASTER AND SLAVE MODES
                                 
                                 CONFIG:
                                 // STARTUP DELAY
000592 ec08                      	LDI		TMP,200						// WAITS TO ENSURE POWER SUPPLY IS STABLE
000593 dfbe                      	RCALL	DELAY_MS
                                 
                                 // DATA INIT
000594 2788                      	CLR		ERRCNT						// RESETS ERROR COUNTER
000595 ef68                      	LDI		DATA_OUT,DEFAULT			//LOADS DEFAULT DATA OUT VALUE
                                 
                                 // STACK CONFIGURATION
000596 ef0f                      	LDI		TMP,LOW(RAMEND)
000597 bf0d                      	OUT		SPL,TMP
000598 e004                      	LDI		TMP,HIGH(RAMEND)
000599 bf0e                      	OUT		SPH,TMP	
                                 
                                 // OPERATION MODE
00059a 2799                      	CLR		FL							// CLEARS FLAGS (ALSO SETS BOARD STD CONFIGURATION AS IN SLAVE MODE)
00059b 994a                      	SBIC	PIND,HW_ID					// CHECKS OPERATION MODE AND STORES FLAG ACCORDINGLY
00059c 6091                      	SBR		FL,(1<<MASTER)					// HW_ID = HIGH -> FLAG HIGH, HW_ID = LOW, LEAVE FLAG IN LOW
                                 
                                 // CONFIGURES DISPLAY
00059d db9f                      	RCALL	DISP_INI
00059e dc20                      	RCALL	CLEAR_SC
                                 //	RCALL	ANIMATION					// RUNS STARTUP ANIMATION
00059f de22                      	RCALL	LOAD_DEF_SCREEN				// LOADS DEFAULT SCREEN INTO DISPLAY
                                 
                                 // ADC INIT
0005a0 e600                      	LDI		TMP,ADC_CFG	
0005a1 9300 007c                 	STS		ADMUX,TMP
0005a3 ec0f                      	LDI		TMP,(1<<ADEN|1<<ADSC|1<<ADIE|1<<ADPS2|1<<ADPS1|1<<ADPS0)	// 0B11100111 - ADC ENABLED, CONVERSION STARTED, INTERRUPT ENABLED, 128:1 PRESCALER
0005a4 9300 007a                 	STS		ADCSRA,TMP
0005a6 e00f                      	LDI		TMP,0B00001111				// DISABLES DIGITAL INPUT BUFFERS - NOT APPLICABLE TO CH 6 AND 7
0005a7 9300 007e                 	STS		DIDR0,TMP
                                 	
                                 // RUNS DEDICATED MODE CONFIGURATION
0005a9 fb90                      	BST		FL,MASTER					// STORES OPERATION MODE IN T BIT
0005aa f416                      	BRTC	HW_SLAVE_MODE				// CHECKS IF T IS CLEAR (SLAVE MODE)
                                 HW_MASTER_MODE:							// T IS SET, BOARD OPERATES IN MASTER MODE
0005ab d005                      	RCALL	CFG_M_MODE
0005ac c002                      	RJMP	END_CFG
                                 HW_SLAVE_MODE:							// T IS CLEAR, BOARD OPERATES IN SLAVE MODE
0005ad d03a                      	RCALL	CFG_S_MODE
0005ae c000                      	RJMP	END_CFG
                                 
                                 END_CFG:
0005af 9478                      	SEI									// ENABLES INTERRUPTS
0005b0 cf24                      	RJMP	MAIN_LOOP
                                 
                                 // -----------------------------------------------------------------------------------------------
                                 //		HW_ID IS HIGH, CONFIGURES BOARD TO OPERATE IN MASTER MODE
                                 
                                 CFG_M_MODE:
                                 // USART INIT
0005b1 e000                      	LDI		TMP,BAUDH					// CONFIGURES BAUD RATE WITH DEFAULT VALUE
0005b2 9300 00c5                 	STS		UBRR0H,TMP
0005b4 e505                      	LDI		TMP,BAUDL
0005b5 9300 00c4                 	STS		UBRR0L,TMP
0005b7 e008                      	LDI		TMP,(1<<TXEN0)				// ENABLES TRANSMITTER
0005b8 9300 00c1                 	STS		UCSR0B,TMP
0005ba e206                      	LDI		TMP,(1<<UPM01|1<<UCSZ01|1<<UCSZ00) // ASYNCHRONOUS MODE, EVEN PARITY, 1 STOP BIT, 8 BIT DATA
0005bb 9300 00c2                 	STS		UCSR0C,TMP
                                 	
                                 //PORT CONFIGURATION
0005bd e90a                      	LDI		TMP,DDRD_INI_M				
0005be b90a                      	OUT		DDRD,TMP
0005bf e300                      	LDI		TMP,DDRC_INI_M
0005c0 b907                      	OUT		DDRC,TMP
0005c1 e007                      	LDI		TMP,DDRB_INI_M
0005c2 b904                      	OUT		DDRB,TMP
                                 
                                 // TIMER 0 CONFIGURATION (INTERRUPT GEN)
0005c3 e002                      	LDI		TMP,0B00000010				// NON PWM MODE, CTC
0005c4 bd04                      	OUT		TCCR0A,TMP
0005c5 e005                      	LDI		TMP,0B00000101				// PRESCALER 1024:1
0005c6 bd05                      	OUT		TCCR0B,TMP
0005c7 ee09                      	LDI		TMP,TX_HF_DEL				// COMPARE TO TX_HF_DEL FOR INTERRUPT
0005c8 bd07                      	OUT		OCR0A,TMP
0005c9 e002                      	LDI		TMP,(1<<OCIE0A)				// ENABLES COMPARE MATCH A INTERRUPT
0005ca 9300 006e                 	STS		TIMSK0,TMP
                                 
                                 // TIMER 2 CONFIGURATION (TH_ADJ)
                                 // TBD
                                  
                                 // TIMER 1 CONFIGURATION (MODE 14 FAST PWM - H BRIDGE PWM A AND B)
0005cc eb02                      	LDI		TMP,(1<<COM1A1|1<<COM1B1|1<<COM1B0|1<<WGM11) // 0B10110010 - MODE 14, CLEAR OC1x ON COMPARE MATCH, CH A NON INVERTING, CH B INVERTING			
0005cd 9300 0080                 	STS		TCCR1A,TMP
0005cf e109                      	LDI		TMP,(1<<WGM13|1<<WGM12|1<<CS10)				// 0B00011001 - MODE 14, PRESCALER 1:1 
0005d0 9300 0081                 	STS		TCCR1B,TMP
0005d2 e000                      	LDI		TMP,DEF_ICR_H				// LOADS DEFAULT TOP VALUE IN ICR1 (DEFAULT FREQUENCY)
0005d3 e51e                      	LDI		TMP2,DEF_ICR_L
0005d4 9300 0087                 	STS		ICR1H,TMP					// (HIGH BYTE MUST BE WRITEN FIRST; READING MUST BE FIRST ON LOW BYTE)
0005d6 9310 0086                 	STS		ICR1L,TMP2
0005d8 9506                      	LSR		TMP							// DIVIDES VALUE BY 2 FOR DUTY = 50 %
0005d9 9517                      	ROR		TMP2
0005da 9300 0089                 	STS		OCR1AH,TMP					// LOADS TOP/2 (DUTY) IN OCR1A AND OCR1B
0005dc 9310 0088                 	STS		OCR1AL,TMP2
0005de 9300 008b                 	STS		OCR1BH,TMP			
0005e0 9310 008a                 	STS		OCR1BL,TMP2	
                                 	
                                 // UPDATES DISPLAY
0005e2 df3b                      	RCALL	FREQ_CALC					// CALCULATES CARRIER FREQUENCY BASED ON CURRENT ICR1(TOP) VALUE AND STORES IN SRAM (FREQ_H:FREQ_M:FREQ_L)
0005e3 2d26                      	MOV		TMP3,FREQ_H					// FREQ_PWM = FREQHZ/(1+TOP)
0005e4 2d35                      	MOV		TMP4,FREQ_M
0005e5 2d44                      	MOV		TMP5,FREQ_L
0005e6 de06                      	RCALL	SHOWS_FREQ					// PRINTS FREQUENCY
0005e7 9508                      	RET
                                 
                                 // -----------------------------------------------------------------------------------------------
                                 //		HW_ID IS LOW, CONFIGURES BOARD TO OPERATE IN SLAVE MODE
                                 
                                 CFG_S_MODE:
                                 //PORT CONFIGURATION
0005e8 e90a                      	LDI		TMP,DDRD_INI_S
0005e9 b90a                      	OUT		DDRD,TMP
0005ea e303                      	LDI		TMP,DDRC_INI_S
0005eb b907                      	OUT		DDRC,TMP
0005ec e003                      	LDI		TMP,DDRB_INI_S
0005ed b904                      	OUT		DDRB,TMP
                                 
                                 // TIMER 0 (TX RESPONSE TIMER)
0005ee e002                      	LDI		TMP,0B00000010				// NON PWM MODE, CTC
0005ef bd04                      	OUT		TCCR0A,TMP
0005f0 2700                      	CLR		TMP							// STARTS WITHOUT CLOCK SOURCE (TIMER STOPPED)
0005f1 bd05                      	OUT		TCCR0B,TMP
0005f2 e005                      	LDI		TMP,R_T_DEL					// COMPARES TO R_T_DEL FOR INTERRUPT (RX TO TX DELAY ON SLAVE MODE)
0005f3 bd07                      	OUT		OCR0A,TMP
0005f4 e000                      	LDI		TMP,0						// STARTS WITH DISABLED INTERRUPTS
0005f5 9300 006e                 	STS		TIMSK0,TMP
                                 
                                 // TIMER 1 CONFIGURATION (BRAKE OUT)
                                 // TIMER 2 NOT USED
                                 
                                 // USART CONFIG FOR SLAVE MODE
0005f7 e000                      	LDI		TMP,BAUDH					// CONFIGURES BAUD RATE WITH DEFAULT VALUE
0005f8 9300 00c5                 	STS		UBRR0H,TMP
0005fa e505                      	LDI		TMP,BAUDL
0005fb 9300 00c4                 	STS		UBRR0L,TMP
0005fd e908                      	LDI		TMP,(1<<RXCIE0|1<<RXEN0|1<<TXEN0)	// ENABLES TX, RX AND RX INTERRUPT
0005fe 9300 00c1                 	STS		UCSR0B,TMP
000600 e206                      	LDI		TMP,(1<<UPM01|1<<UCSZ01|1<<UCSZ00) // ASYNCHRONOUS MODE, EVEN PARITY, 1 STOP BIT, 8 BIT DATA
000601 9300 00c2                 	STS		UCSR0C,TMP
                                 
000603 6092                      	ORI		FL,(1<<RX_WIN)				// RX DATA WILL NOT BE IGNORED
                                 
000604 9508                      	RET
                                 
                                 
                                 
                                 


