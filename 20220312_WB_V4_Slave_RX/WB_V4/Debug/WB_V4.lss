00039c e604                      	LDI		TMP,100
00039d d1b4                      	RCALL	DELAY_MS
00039e e0f0
00039f e3e6
0003a0 e000
0003a1 de00                      	P_STR	BL_STR,0					// PRINTS "WIRELESS" WITHOUT DELAY BETWEEN CHARS
                                 INV_PREP:
0003a2 e017                      	LDI		TMP2,7
0003a3 e004                      	LDI		TMP,4
                                 INV_ANIM:
0003a4 d1a1                      	RCALL	DELAY_DS
0003a5 de52                      	RCALL	OLED_B						// BLACK PIXELS IN WHITE BACKGROUND
0003a6 d19f                      	RCALL	DELAY_DS
0003a7 de58                      	RCALL	OLED_W						// WHITE PIXELS IN BLACK BACKGROUND
0003a8 2f20                      	MOV		TMP3,TMP					//	TMP = TMP+TMP/2
0003a9 9526                      	LSR		TMP3
0003aa 0f02                      	ADD		TMP,TMP3
0003ab 951a                      	DEC		TMP2
0003ac f7b9                      	BRNE	INV_ANIM
                                 TRANS_REC:								// PRINT REVISION
0003ad e302                      	LDI		TMP,50
0003ae d197                      	RCALL	DELAY_DS
0003af e0b5                      	LDI		POSV,5
0003b0 ddd6                      	RCALL	SET_POS
                                 
0003b1 ff90                      	SBRS	FL,MASTER					// CHECKS IF DEVICE IS IN MASTER MODE
0003b2 c005                      	RJMP	SET_ID_STR_S
                                 //	RJMP	SET_ID_STR_M				// LOADS MASTER STRING (LOW = SLAVE, HIGH = MASTER)
