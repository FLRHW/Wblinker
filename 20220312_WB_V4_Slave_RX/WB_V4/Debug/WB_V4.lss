                                 W_STR:
000036 7753
000037 203a
000038 8080                      .DB "WIRELESS ", CHAR_LIM
                                 
                                 BL_STR:
                                 .DB "BLINKER", CHAR_LIM
                                 
                                 V4_M_STR:
                                 .DB "V4 MASTER", CHAR_LIM
                                 
                                 V4_S_STR:
                                 .DB "V4 SLAVE ", CHAR_LIM
                                 
                                 DO_STR:
                                 .DB "Dout:", CHAR_LIM
                                 
                                 DI_STR:
                                 .DB "Din: ", CHAR_LIM
                                 
                                 MM_STR:
                                 .DB "MASTER ", CHAR_LIM
                                 
                                 SM_STR:
                                 .DB "SLAVE", CHAR_LIM
                                 
                                 SW_STR:
                                 .DB "Sw: ", CHAR_LIM, CHAR_LIM
                                 
                                 // -----------------------------------------------------------------------------------------------
                                 //		MACRO DEFINITION
                                 
                                 // PCHAR	@0		->	PRINTS CHAR @0
                                 .MACRO		P_CHAR
                                 	LDI		PAYLD,@0
                                 	RCALL	CHAR6X8
                                 .ENDMACRO
                                 
                                 // POS_DEF	@0,@1	->	DEFINES CURSOR VERTICAL POSITION @0 AND HORIZONTAL POSITION @1	
                                 // WORKS IN THE RANGE 0-123,0-7; 124-126 WORKS WILL BREAK A CHARACTER, 127+ WILL START FROM 0
                                 .MACRO		POS_DEF
                                 	LDI		POSV,@0						// LOADS VERTICAL PRINT POSITION
                                 	LDI		POSH,@1						// LOADS HORIZONTAL PRINT POSITION
                                 	RCALL	SET_POS						// SETS DISPLAY PRINT POSITION
                                 .ENDMACRO
                                 
                                 // P_STR	@0,@1	-> PRINTS STRING STORED IN @0 WITH @1 DELAY (mS) BETWEEN CHARS
                                 .MACRO		P_STR
                                 	LDI		ZH,HIGH(2*@0)
                                 	LDI		ZL,LOW(2*@0)
                                 	LDI		TMP,@1
                                 	RCALL	PRINTSTR
                                 .ENDMACRO
                                 
                                 // BACKUPS CONTEXT FOR INTERRUPTIONS
                                 .MACRO		CONTEXT_BACKUP
                                 	PUSH	TMP							// BACKUPS TMP
                                 	IN		TMP,SREG
                                 	PUSH	TMP							// BACKUPS SREG
                                 	PUSH	TMP2						// BACKUPS TMP2
                                 .ENDMACRO
                                 
                                 // RESTORES CONTEXT AFTER INTERRUPTION ROUTINES ARE SERVICED
                                 .MACRO		CONTEXT_RESTORE
                                 	POP		TMP2						// RESTORES TMP2
                                 	POP		TMP							// RESTORES SREG
                                 	OUT		SREG,TMP	
                                 	POP		TMP							// RESTORES TMP
                                 .ENDMACRO
                                 
                                 // BACKUPS EXTENDED CONTEXT FOR INTERRUPTIONS
                                 .MACRO		EXT_CONTEXT_BACKUP
                                 	PUSH	DDRT0
                                 	PUSH	DDRT1
                                 	PUSH	DDRT2
                                 	PUSH	DDRT3
                                 	PUSH	DVRS0
                                 	PUSH	DVRS1
                                 	PUSH	R0
                                 	PUSH	R1
                                 	PUSH	TMP3
                                 	PUSH	TMP4
                                 .ENDMACRO
                                 
                                 // RESTORES EXTENDED CONTEXT AFTER INTERRUPTION ROUTINES ARE SERVICED
                                 .MACRO		EXT_CONTEXT_RESTORE
                                 	POP		TMP4
                                 	POP		TMP3
                                 	POP		R1
                                 	POP		R0
                                 	POP		DVRS1
                                 	POP		DVRS0
                                 	POP		DDRT3
                                 	POP		DDRT2
                                 	POP		DDRT1
                                 	POP		DDRT0
                                 .ENDMACRO
                                 
                                 .MACRO		LED1_ON
                                 	SBI		PORTD,LED1
                                 .ENDMACRO
                                 
                                 .MACRO		LED2_ON
                                 	SBI		PORTD,LED2
                                 .ENDMACRO
                                 
                                 .MACRO		LED3_ON
                                 .INCLUDE "interruptions.inc"
                                 
                                 	 
                                 	FELIPE LOPASSO RODRIGUES
                                 	********************************************************************************************** */
                                 
                                 
                                 // -----------------------------------------------------------------------------------------------
                                 //		USART DATA HAS BEEN RECEIVED
                                 
                                 USART_RX:
000039 930f
00003a b70f
00003b 930f
00003c 931f                      	CONTEXT_BACKUP
                                 
00003d 9100 00c6                 	LDS		TMP,UDR0					// LOADS RECEIVED DATA IN TMP TO CLEAR INTERRUPT STATE
00003f ff91                      	SBRS	FL,RX_WIN					// CHECKS IF RX WINDOW IS OPENED
000040 c012                      	RJMP	INT_RX_END					// NO (RX_WIN=0), ENDS INTERRUPT IGNORING RECEIVED DATA
                                 WINDOW_OPENED:
000041 9110 00c0                 	LDS		TMP2,UCSR0A					// SAVES STATUS REGISTER IN TMP2
000043 7114                      	ANDI	TMP2,(1<<FE0|1<<UPE0)		// CHECKS FRAME ERROR AND PARITY ERROR
000044 f471                      	BRNE	INT_RX_END					// ERRORS DETECTED, IGNORES DATA AND FINISHES INTERRUPT
                                 NO_ERROR:								// NO ERRORS DETECTED, TRANSMISSION HAS BEEN CORRECTLY RECEIVED
000045 2f70                      	MOV		DATA_IN,TMP					// STORES DATA RECEIVED (PREVIOUSLY LOADED ON TMP REGISTER)
                                 //	SBR		FL,NEW_DATA					// SETS NEW DATA RECEIVED FLAG
000046 ff90                      	SBRS	FL,MASTER					// CHECKS IF BOARD OPERATES IN MASTER MOVE, IF SO, CONFIGURES UART AND FLAG FOR MASTER MODE
000047 c002                      	RJMP	RX_S_CFG					// IF NOT, CONFIGURES USART AND FLAG FOR SLAVE MODE
                                 
                                 RX_M_CFG:
000048 7f9d                      	ANDI	FL,255-(1<<RX_WIN)			// CLOSES RX WINDOW SO THAT NEXT DATA WILL BE IGNORED
000049 c009                      	RJMP	INT_RX_END
                                 
                                 RX_S_CFG:
00004a 2700                      	CLR		TMP
00004b 9300 0026                 	STS		TCNT0,TMP					// CLEARS TIMER0 COUNTER
00004d e002                      	LDI		TMP,(1<<OCIE0A)				// ENABLES COMPARE MATCH A INTERRUPT
00004e 9300 006e                 	STS		TIMSK0,TMP
000050 e005                      	LDI		TMP,0B00000101				// STARTS TIMER (PRESCALER 1024:1)
000051 bd05                      	OUT		TCCR0B,TMP
000052 c000                      	RJMP	INT_RX_END
                                 INT_RX_END:								// FINALIZES INTERRUPTION ROUTINE
000053 911f
000054 910f
000055 bf0f
000056 910f                      	CONTEXT_RESTORE
000057 9518                      	RETI
                                 
                                 // -----------------------------------------------------------------------------------------------
                                 //		USART TX COMPLETE
                                 
                                 USART_TX:
000058 930f
000059 b70f
00005a 930f
00005b 931f                      	CONTEXT_BACKUP
00005c ff90                      	SBRS	FL,MASTER					// CHECKS IF BOARD OPERATES IN MASTER MOVE, IF SO, CONFIGURES UART AND FLAG FOR MASTER MODE
                                 //	RJMP	TX_S_CFG					// IF NOT, CONFIGURES FLAG FOR SLAVE MODE
00005d 6092                      	ORI		FL,1<<RX_WIN				// CLEARS FLAG TO ACCEPT RECEIVE DATA
                                 //	RJMP	USART_TX_END
                                 TX_M_CFG:
00005e e908                      	LDI		TMP,(1<<RXCIE0|1<<RXEN0|1<<TXEN0)	// ENABLES RECEPTION INTERRUPT AND RECEIVER WHILE KEEPING
00005f 9300 00c1                 	STS		UCSR0B,TMP					// TRANSMITTER ENABLED AND TX INTERRUPT DISABLED
000061 6094                      	ORI		FL,1<<TX_CP					// INDICATES THAT A TRANSMISSION HAS BEEN COMPLETED SINCE LAST TRANSMIT TENTATIVE
000062 c001                      	RJMP	USART_TX_END
                                 TX_S_CFG:
000063 6092                      	ORI		FL,1<<RX_WIN				// CLEARS FLAG TO ACCEPT RECEIVE DATA
                                 //	RJMP	USART_TX_END
                                 USART_TX_END:
000064 911f
000065 910f
000066 bf0f
000067 910f                      	CONTEXT_RESTORE
000068 9518                      	RETI
                                 
                                 
                                 // -----------------------------------------------------------------------------------------------
                                 //		TMR0 MATCH
                                 
                                 TMR0_COMPA:
000069 930f
00006a b70f
00006b 930f
00006c 931f                      	CONTEXT_BACKUP
00006d ff90                      	SBRS	FL,MASTER					// CHECKS IF BOARD OPERATES IN MASTER MOVE, IF SO, CONTINUES WITH MASTER ROUTINES
00006e c01e                      	RJMP	TMR0_SLAVE					// IF NOT, CONTINUES WITH SLAVE ROUTINES
                                 
00006f fd93                      	SBRC	FL,T0_TX					// CHECKS IF TIMER WAS SET TO INTERRUPT FOR NEXT TRANSMISSION
000070 c00d                      	RJMP	TMR_TX						// YES (T0_TX=1), GOES TO TRANSMISSION ROUTINE
                                 NOT_TMR_TX:
000071 fd94                      	SBRC	FL,T0_RXEN					// CHECKS IF TIMER WAS SET TO "OPEN" RX WINDOW
000072 c005                      	RJMP	TMR_RXEN					// YES (TO_RXEN=1), GOES TO RX WINDOW OPENING ROUTINE
                                 MID_TMR:								// NO, GOES TO MID TIMER ROUTINE
000073 ee09                      	LDI		TMP,TX_HF_DEL				// UPDATES TIMER TO INTERRUPT. DELAY CORRESPONDS TO HALF THE TIME BETWEEN RX ENABLE WINDOW AND TRANSMIT START
000074 bd07                      	OUT		OCR0A,TMP
000075 7e9f                      	ANDI	FL,255-(1<<T0_RXEN)			// CLOSES RX WINDOW
000076 6098                      	ORI		FL,1<<T0_TX					// UPDATES TIMER STATE FLAG. NEXT TIMER INTERRUP: NOT(T0_RXEN), T0_TX
000077 c024                      	RJMP	TMR0_INT_END
                                 
                                 TMR_RXEN:
000078 ee09                      	LDI		TMP,TX_HF_DEL				// UPDATES TIMER TO INTERRUPT. DELAY CORRESPONDS TO TIME BETWEEN RX ENABLE WINDOW AND MID TMR INTERRUPT
000079 bd07                      	OUT		OCR0A,TMP
00007a 7e97                      	ANDI	FL,255-(1<<T0_RXEN|1<<T0_TX)// UPDATES TIMER STATE FLAGS. NEXT TIMER INTERRUPT: NOT(T0_RXEN), NOT(T0_TX)
00007b fd92                      	SBRC	FL,TX_CP					// CHECKS WHETHER A TX COMPLETE INTERRUPT HAS BEEN EXECUTED AFTER LAST TRANSMIT TENTATIVE
00007c 6092                      	ORI		FL,1<<RX_WIN				// YES, THEN "OPENS" RX WINDOW
00007d c01e                      	RJMP	TMR0_INT_END				// NO, KEEPS RX WINDOW "CLOSED" AND FINISHES INTERRUPT ROUTINE
                                 
                                 TMR_TX:
00007e e103                      	LDI		TMP,RXEN_DEL				// UPDATES TIMER TO INTERRUPT. DELAY CORRESPONDS TO TIME BETWEEN TX START AND RX ENABLE WINDOW
00007f bd07                      	OUT		OCR0A,TMP
000080 6190                      	ORI		FL,1<<T0_RXEN				// UPDATES TIMER STATE FLAGS. NEXT TIMER INTERRUPT: T0_RXEN, NOT(T0_TX)
000081 7f97                      	ANDI	FL,255-(1<<T0_TX)
000082 7f9b                      	ANDI	FL,255-(1<<TX_CP)			// UPDATES TRANSMISSION STATE FLAGS (CLEARS TRANSMISSION COMPLETE)
000083 e408                      		LDI		TMP,(1<<TXEN0|1<<TXCIE0)	// ENABLES TRANSMITTER, ENABLES TRANSMISSION COMPLETE INTERRUPT, DISABLES RECEIVER AND RECEIVE INTERRUPT
000084 9300 00c1                 		STS		UCSR0B,TMP
                                 M_TRANSMIT:
000086 9100 00c0                 	LDS		TMP,UCSR0A
000088 ff05                      	SBRS	TMP,UDRE0					// CHECKS IF NEW TRANSMISSION CAN BE EXECUTED (IF DATA REGISTER IS EMPTY, UDRE0=1)
000089 cffc                      	RJMP	M_TRANSMIT					// IF NOT, CHECKS AGAIN UNTIL PERIPHERAL IS READY
00008a 9360 00c6                 	STS		UDR0,DATA_OUT				// STORES NEW DATA IN TRASMIT BUFFER
00008c c00f                      	RJMP	TMR0_INT_END
                                 
                                 TMR0_SLAVE:
00008d ed08                      		LDI		TMP,(1<<TXEN0|1<<TXCIE0|1<<RXEN0|1<<RXCIE0)	// ENABLES TRANSMITTER WHILE KEEPING RECEIVER AND RX INTERRUPT ENABLED
00008e 9300 00c1                 		STS		UCSR0B,TMP
000090 2700                      	CLR		TMP							// STOPS TIMER
000091 bd05                      	OUT		TCCR0B,TMP
000092 e000                      	LDI		TMP,0						// DISABLES TIMER INTERRUPT
000093 9300 006e                 	STS		TIMSK0,TMP
000095 7f9d                      	ANDI	FL,255-(1<<RX_WIN)			// SETS FLAG TO IGNORE RECEIVE DATA
                                 S_TRANSMIT:
000096 9100 00c0                 	LDS		TMP,UCSR0A
000098 ff05                      	SBRS	TMP,UDRE0					// CHECKS IF NEW TRANSMISSION CAN BE EXECUTED (IF DATA REGISTER IS EMPTY, UDRE0=1)
000099 cffc                      	RJMP	S_TRANSMIT					// IF NOT, CHECKS AGAIN UNTIL PERIPHERAL IS READY
00009a 9360 00c6                 	STS		UDR0,DATA_OUT				// STORES NEW DATA IN TRASMIT BUFFER
                                 //	RJMP	TMR0_INT_END
                                 
                                 TMR0_INT_END:
00009c 911f
00009d 910f
00009e bf0f
00009f 910f                      	CONTEXT_RESTORE
0000a0 9518                      	RETI
                                 
                                 
                                 // -----------------------------------------------------------------------------------------------
                                 //		AD CONVERSION COMPLETE
                                 
                                 ADC_COMPLETE:
                                 //RETI
0000a1 930f
0000a2 b70f
0000a3 930f
0000a4 931f                      	CONTEXT_BACKUP
0000a5 928f
0000a6 929f
0000a7 92af
0000a8 92bf
0000a9 92cf
0000aa 92df
0000ab 920f
0000ac 921f
0000ad 932f
0000ae 933f                      	EXT_CONTEXT_BACKUP
                                 
0000af 9100 007c                 	LDS		TMP,ADMUX
0000b1 700f                      	ANDI	TMP,0B00001111				// LEAVES ONLY BITS RELEVANT TO ADC MUX
0000b2 3000                      	CPI		TMP,0						// CHECKS WHAT CHANNEL HAS BEEN READ AND TREATS ACCORDINGLY
0000b3 f059                      	BREQ	STORES_ADC0
0000b4 3001                      	CPI		TMP,1
0000b5 f0a9                      	BREQ	STORES_ADC1
0000b6 3002                      	CPI		TMP,2
0000b7 f0d9                      	BREQ	STORES_ADC2
0000b8 3003                      	CPI		TMP,3
0000b9 f199                      	BREQ	STORES_ADC3
0000ba 3006                      	CPI		TMP,6
0000bb f0f9                      	BREQ	STORES_ADC6
0000bc 3007                      	CPI		TMP,7
0000bd f131                      	BREQ	STORES_ADC7
0000be c03c                      	RJMP	END_ADC
                                 
                                 STORES_ADC0:
0000bf ff95                      	SBRS	FL,ADC_REF_C				// CHECKS IF THE REFERENCE HAS JUST BEEN CHANGED JUST BEFORE LAST CONVERSION
0000c0 c002                      	RJMP	ADC0_REF_STABLE				// NO, SO STORES DATA
                                 ADC0_REF_CHANGED:						// YES, IGNORES DATA READ ON LAST CONVERSION
0000c1 7d9f                      	ANDI	FL,255-(1<<ADC_REF_C)		// INDICATES THE REFERENCE WILL BE STABLE FOR NEXT CYCLE
0000c2 c038                      	RJMP	END_ADC
                                 ADC0_REF_STABLE:
0000c3 9100 0079                 	LDS		TMP,ADCH
0000c5 9300 0100                 	STS		AIN_RIGHT,TMP
0000c7 e601                      	LDI		TMP,(ADC_CFG|1)
0000c8 9300 007c                 	STS		ADMUX,TMP					// SETS NEXT CHANNEL AS CH 1, KEEPS AVCC AS REFERENCE
0000ca c030                      	RJMP	END_ADC
                                 
                                 STORES_ADC1:
0000cb 9100 0079                 	LDS		TMP,ADCH
0000cd 9300 0101                 	STS		AIN_LEFT,TMP
0000cf e602                      	LDI		TMP,(ADC_CFG|2)
0000d0 9300 007c                 	STS		ADMUX,TMP					// SETS NEXT CHANNEL AS CH 2, KEEPS AVCC AS REFERENCE
0000d2 c028                      	RJMP	END_ADC
                                 
                                 STORES_ADC2:
0000d3 9100 0079                 	LDS		TMP,ADCH
0000d5 9300 0102                 	STS		AIN_L_DET,TMP
0000d7 e606                      	LDI		TMP,(ADC_CFG|6)
0000d8 9300 007c                 	STS		ADMUX,TMP					// SETS NEXT CHANNEL AS CH 6, KEEPS AVCC AS REFERENCE
0000da c020                      	RJMP	END_ADC
                                 
                                 STORES_ADC6:
0000db 9100 0079                 	LDS		TMP,ADCH
0000dd 9300 0104                 	STS		AIN_SW,TMP
0000df d02f                      	RCALL	CONV_SW
0000e0 e607                      	LDI		TMP,(ADC_CFG|7)
0000e1 9300 007c                 	STS		ADMUX,TMP					// SETS NEXT CHANNEL AS CH 0, KEEPS AVCC AS REFERENCE
0000e3 c017                      	RJMP	END_ADC
                                 
                                 STORES_ADC7:
0000e4 9100 0079                 	LDS		TMP,ADCH
0000e6 9300 0105                 	STS		AIN_BRAKE,TMP
0000e8 ee03                      	LDI		TMP,(ADC_CFG|1<<REFS1|3)
0000e9 9300 007c                 	STS		ADMUX,TMP					// SETS NEXT CHANNEL AS CH 3, CHANGES REFERENCE TO 1.1 V
0000eb 6290                      	ORI		FL,(1<<ADC_REF_C)			// INDICATES REFERENCE HAS BEEN CHANGED
0000ec c00e                      	RJMP	END_ADC
                                 
                                 STORES_ADC3:
0000ed 94ea                      	DEC		ADC_C_COUNTER				// DECREASES ADC WAIT CYCLES COUNTER
0000ee f461                      	BRNE	END_ADC						// IF COUNTER HAS NOT REACHED 0, IGNORES DATA FROM THIS CYCLE
                                 ADC3_COUNTER_END:						// COUNTER HAS REACHED 0
0000ef e604                      	LDI		TMP,ADC_WAIT_CYCLES
0000f0 2ee0                      	MOV		ADC_C_COUNTER,TMP			// REFRESHES ADC WAIT CYCLES COUNTER WITH TOP COUNTING VALUE
                                 
0000f1 9100 0079                 	LDS		TMP,ADCH
0000f3 9300 0103                 	STS		AIN_12V,TMP
0000f5 d03a                      	RCALL	CONV_UBAT
0000f6 e600                      	LDI		TMP,(ADC_CFG)
0000f7 9300 007c                 	STS		ADMUX,TMP					// SETS NEXT CHANNEL AS CH 7, CHANGES REFERENCE TO AVCC
0000f9 6290                      	ORI		FL,(1<<ADC_REF_C)			// INDICATES REFERENCE HAS BEEN CHANGED
0000fa c000                      	RJMP	END_ADC
                                 
                                 END_ADC:
0000fb 9100 007a                 	LDS		TMP,ADCSRA
0000fd 6400                      	ORI		TMP,(1<<ADSC)				// SETS START CONVERSION BIT
0000fe 9300 007a                 	STS		ADCSRA,TMP
000100 913f
000101 912f
000102 901f
000103 900f
000104 90df
000105 90cf
000106 90bf
000107 90af
000108 909f
000109 908f                      	EXT_CONTEXT_RESTORE
00010a 911f
00010b 910f
00010c bf0f
00010d 910f                      	CONTEXT_RESTORE
00010e 9518                      	RETI
                                 
                                 // -----------------------------------------------------------------------------------------------
                                 //		CONVERTS SWITCHES ADC VALUE STORED IN TMP TO A DECIMAL TO BE DISPLAYED AND STORES IT IN SW_DATA
                                 
                                 CONV_SW:
00010f 2d17                      	MOV		TMP2,UBAT
000110 3015                      	CPI		TMP2,05						// IN CASE VBAT IS TOO LOW ADC SW VALUES CANNOT BE TRUSTED
000111 f070                      	BRLO	SW_C_0
                                 
000112 3905                      	CPI		TMP,149
000113 f0d0                      	BRLO	SW_C_7
000114 390e                      	CPI		TMP,158
000115 f0b0                      	BRLO	SW_C_6
000116 3a0a                      	CPI		TMP,170
000117 f090                      	BRLO	SW_C_5
000118 3b09                      	CPI		TMP,185
000119 f070                      	BRLO	SW_C_4
00011a 3c0b                      	CPI		TMP,203
00011b f050                      	BRLO	SW_C_3
00011c 3d0d                      	CPI		TMP,221
00011d f030                      	BRLO	SW_C_2
00011e 3f04                      	CPI		TMP,244
00011f f010                      	BRLO	SW_C_1
                                 SW_C_0:
000120 e0d0                      	LDI		SW_DATA,0
000121 9508                      	RET
                                 SW_C_1:
000122 e6d4                      	LDI		SW_DATA,100
000123 9508                      	RET
                                 SW_C_2:
000124 e0da                      	LDI		SW_DATA,10
000125 9508                      	RET
                                 SW_C_3:
000126 e6de                      	LDI		SW_DATA,110
000127 9508                      	RET
                                 SW_C_4:
000128 e0d1                      	LDI		SW_DATA,1
000129 9508                      	RET
                                 SW_C_5:
00012a e6d5                      	LDI		SW_DATA,101
00012b 9508                      	RET
                                 SW_C_6:
00012c e0db                      	LDI		SW_DATA,11
00012d 9508                      	RET
                                 SW_C_7:
00012e e6df                      	LDI		SW_DATA,111
00012f 9508                      	RET
                                 
                                 
                                 // -----------------------------------------------------------------------------------------------
                                 //		CONVERTS ADC VALUE STORED IN TMP TO BATERY VOLTAGE X 10 (E.G.: 137 = 13.7 V) AND STORES IT IN UBAT
                                 
                                 CONV_UBAT:
000130 ee18                      	LDI		TMP2,232
000131 9f01                      	MUL		TMP,TMP2					// MULTIPLIES BY 232 (10 x FACTOR TO OBTAIN ONE DECIMAL DIGIT)
                                 	
000132 2c80                      	MOV		DDRT0,R0					// LOADS MULTIPLICATION RESULT INTO DDRTx
000133 2c91                      	MOV		DDRT1,R1
000134 2700                      	CLR		TMP
000135 2ea0                      	MOV		DDRT2,TMP
000136 2eb0                      	MOV		DDRT3,TMP
000137 2ed0                      	MOV		DVRS1,TMP					// LOADS 255 INTO DVRSx
000138 ef0f                      	LDI		TMP,255
000139 2ec0                      	MOV		DVRS0,TMP
00013a d441                      	RCALL	udiv32_16					// DIVIDES BY 255
00013b 2c78                      	MOV		UBAT,DDRT0
00013c 9508                      	RET
                                 .INCLUDE "SSD1306TWIDRIVER.inc"
                                 
                                 /*		DRIVER FOR 128 X 64 OLED DISPLAY (SSD1306)
                                 
                                 FOLLOWING REGISTERS MUST BE DEFINED, BUT WILL NOT BE CHANGED BY THE ROUTINES:
                                 	TMP		->		GENERAL PURPOSE REGISTER, INPUT TO SOME ROUTINES
                                 	TMP2	->		GENERAL PURPOSE REGISTER (USED IN DELAY ROUTINES)
                                 	TMP3	->		GENERAL PURPOSE REGISTER (USED IN DELAY ROUTINES)
                                 	POSH	->		HORIZONTAL POSITION (COLUMN) TO START PRINTING DATA, 0 TO 127
                                 	POSV	->		VERTICAL POSITION (PAGE) TO START PRINTING DATA, 0 TO 8
                                 	PAYLD	->		DATA TO BE PRINTED
                                 
                                 FOLLOWING REGISTERS WILL BE USED, BUT NOT CHANGED BY THE ROUTINES:
                                 	ZL		->		Z POINTER, LOW BYTE
                                 	ZH		->		Z POINTER, HIGH BYTE
                                 
                                 FOLLOWING LIBRARIES ARE NEEDED:
                                 	DELAYS.INC
                                 
                                 AUTHOR: FELIPE LOPASSO RODRIGUES
                                 NOVEMBER 2020
                                 
                                 */
                                 
                                 // ---------------------------------------------------------------------------------------------------
                                 // CONSTANTS DEFINITION
                                 
                                 .EQU	OLED_INI_LEN	=	8		// BYTES TO INITIALIZE OLED DISPLAY
                                 .EQU	OLED_INI_DEL	=	50		// INITIALIZTION DELAY
                                 .EQU	OLED_ADDR		=	0x78	// OLED ADDRESS + R/W BIT
                                 .EQU	WCOMM			=	0X00	// CONTROL BYTE -> COMMAND MODE
                                 .EQU	WDATA			=	0x40	// CONTROL BYTE -> DATA MODE
                                 .EQU	CHAR_LIM		=	128		// ID OF LAST CHAR IN THE FONT DATABASE (NOT PRINTABLE)
                                 .EQU	NUM_COL			=	128		// NUMBER OF DISPLAY COLUMNS
                                 .EQU	NUM_PAG			=	8		// NUMBER OF DISPLAY PAGES
                                 .EQU	HLIM6X8			=	122		// HORIZONTAL LIMIT FOR PRITING A 6X8 CHAR
                                 .EQU	VLIM6X8			=	7		// VERTICAL LIMIT FOR PRINTING A 6X8 CHAR
                                 
                                 // ---------------------------------------------------------------------------------------------------
                                 // INITIALIZES DISPLAY, NO INPUTS REQUIRED, NO REGISTERS ARE CHANGED
                                 
                                 DISP_INI:
00013d 930f                      	PUSH	TMP					// REGISTER(S) BACKUP
00013e 93cf                      	PUSH	PAYLD
00013f 93ef                      	PUSH	ZL
000140 93ff                      	PUSH	ZH
                                 
000141 e302                      	LDI		TMP,OLED_INI_DEL	// DELAY FOR POWER STABILIZATION
000142 d40f                      	RCALL	DELAY_MS
                                 
                                 // CONFIGURES POWER REDUCTION
000143 9100 0064                 	LDS		TMP,PRR				
000145 770f                      	ANDI	TMP,0B01111111		// CLEARS TWI POWER REDUCTION BIT, I.E. TWI IS ACTIVE
000146 9300 0064                 	STS		PRR,TMP
                                 //	BITRATE CONFIG ~X KHz @ X MHz 1:1, 1:1
000148 e00a                      	LDI		TMP,10				// 1:1 DIVIDER
000149 9300 00b8                 	STS		TWBR,TMP
00014b e000                      	LDI		TMP,0				// 1:1 PRESCALER
00014c 9300 00b9                 	STS		TWSR,TMP
                                 
00014e d01c                      	RCALL	TWISTART			// STARTS TWI
00014f d00d                      	RCALL	CFGCOMM				// SETS TWI TO COMMAND MODE
000150 e0f4                      	LDI		ZH,HIGH(2*DISP_INI_DATA)	// POINTS Z TO DISPLAY INITIALIZATION DATA
000151 e1e0                      	LDI		ZL,LOW(2*DISP_INI_DATA)		
000152 e008                      	LDI		TMP,OLED_INI_LEN	// LOADS THE LENGTH OF DISPLAY INITIALIZATION DATA
                                 
                                 
                                 INI_SEQ:
000153 91c5                      	LPM		PAYLD,Z+			// LOADS DATA BYTE INTO PAYLD, INCREMENTS POINTER AFTERWARDS
000154 d026                      	RCALL	SEND_BYTE
000155 950a                      	DEC		TMP					// CHECKS IF ALL BYTES OF CONFIG DATA HAVE BEEN SENT
000156 f7e1                      	BRNE	INI_SEQ				// IF NOT, SENDS NEXT
000157 d01d                      	RCALL	TWISTOP				// ALL BYTES HAVE BEEN SENT, STOPS TWI
                                 
000158 91ff                      	POP		ZH					// RESTORES REGISTER(S)
000159 91ef                      	POP		ZL
00015a 91cf                      	POP		PAYLD
00015b 910f                      	POP		TMP
00015c 9508                      	RET
                                 
                                 
                                 // ---------------------------------------------------------------------------------------------------
                                 // SETS TWI TO COMMAND MODE, NO REGISTERS ARE CHANGED
                                 
                                 CFGCOMM:
00015d 93cf                      	PUSH	PAYLD				// REGISTER(S) BACKUP
                                 
                                 //	RCALL	TWISTART			// SENDS START CONDITION
00015e e7c8                      	LDI		PAYLD,OLED_ADDR		// SENDS ADDRESS
00015f d01b                      	RCALL	SEND_BYTE
000160 e0c0                      	LDI		PAYLD,WCOMM			// SETS OLED TO COMMAND MODE
000161 d019                      	RCALL	SEND_BYTE
                                 
000162 91cf                      	POP		PAYLD				// RESTORES REGISTER(S)
000163 9508                      	RET
                                 
                                 // ---------------------------------------------------------------------------------------------------
                                 // SETS TWI TO DATA MODE, NO REGISTERS ARE CHANGED
                                 
                                 CFGDATA:
000164 93cf                      	PUSH	PAYLD				// REGISTER(S) BACKUP
                                 
                                 //	RCALL	TWISTART			// SENDS START CONDITION
000165 e7c8                      	LDI		PAYLD,OLED_ADDR		// SENDS ADDRES
000166 d014                      	RCALL	SEND_BYTE
000167 e4c0                      	LDI		PAYLD,WDATA			// SETS OLED TO DATA MODE
000168 d012                      	RCALL	SEND_BYTE
                                 
000169 91cf                      	POP		PAYLD				// RESTORES REGISTER(S)
00016a 9508                      	RET	
                                 
                                 // ---------------------------------------------------------------------------------------------------
                                 // SENDS START CONDITION, NO REGISTERS ARE CHANGED
                                 
                                 TWISTART:
00016b 930f                      	PUSH	TMP					// REGISTER(S) BACKUP
                                 
00016c ea04                      	LDI		TMP,(1<<TWINT)|(1<<TWSTA)|(1<<TWEN)
00016d 9300 00bc                 	STS		TWCR,TMP			// SETS START CONDITION, CLEARS FLAG, ENABLES TWI
                                 
                                 WAITSTA:
00016f 9100 00bc                 	LDS		TMP,TWCR			// WAITS UNTIL FLAG TWINT IS SET, CONFIRMING START CONDITION HAS BEEN SENT
000171 ff07                      	SBRS	TMP,TWINT
000172 cffc                      	RJMP	WAITSTA
                                 
000173 910f                      	POP		TMP					// RESTORES REGISTER(S)
000174 9508                      	RET
                                 
                                 // ---------------------------------------------------------------------------------------------------
                                 // SENDS STOP CONDITION, NO REGISTERS ARE CHANGED (EXCEPT SREG)
                                 
                                 TWISTOP:
000175 930f                      	PUSH	TMP					// REGISTER(S) BACKUP
                                 
000176 e904                      	LDI		TMP,(1<<TWINT)|(1<<TWSTO)|(1<<TWEN)
000177 9300 00bc                 	STS		TWCR,TMP			// SEND STOP CONDITION, CLEAR FLAG
                                 
000179 910f                      	POP		TMP					// RESTORES REGISTER(S)
00017a 9508                      	RET
                                 		
                                 // ---------------------------------------------------------------------------------------------------
                                 // SENDS DATA FROM PAYLD, NO REGISTERS ARE CHANGED (EXCEPT SREG)
                                 
                                 SEND_BYTE:		
00017b 930f                      	PUSH	TMP					// REGISTER(S) BACKUP
                                 
00017c 93c0 00bb                 	STS		TWDR,PAYLD			// MOVES PAYLD TO TWI DATA REGISTER
00017e e804                      	LDI		TMP,(1<<TWINT)|(1<<TWEN)
00017f 9300 00bc                 	STS		TWCR,TMP			// ENABLES DATA TRANSFER
                                 WAITTR:
000181 9100 00bc                 	LDS		TMP,TWCR			// WAITS UNTIL FLAG TWINT IS SET, CONFIRMING DATA HAS BEEN SENT
000183 ff07                      	SBRS	TMP,TWINT
000184 cffc                      	RJMP	WAITTR
                                 
000185 910f                      	POP		TMP					// RESTORES REGISTER(S)
000186 9508                      	RET
                                 
                                 // ---------------------------------------------------------------------------------------------------
                                 // SET POS FROM POSH -> COLUMNS (0-127), POSV -> PAGES (0-7)
                                 // WORKS WITH CHARS IN THE RANGE 0-123,0-7; 124-126 WORKS BUT WILL BREAK A CHARACTER, 127+ WILL START FROM 0
                                 
                                 SET_POS:
000187 93af                      	PUSH	POSH				// REGISTER(S) BACKUP
000188 93bf                      	PUSH	POSV
000189 93cf                      	PUSH	PAYLD
                                 
00018a 38a0                      	CPI		POSH,128			// CHECKS IF HORIZONTAL POSITION IS IN RANGE
00018b f008                      	BRLO	HINRANGE			// YES, CONTINUES TO NEXT STEPS
00018c 27aa                      	CLR		POSH				// NO, LOADS FIRST COLUMN
                                 HINRANGE:
00018d 30b8                      	CPI		POSV,8				// CHECKS IF VERTICAL POSITION IS IN RANGE
00018e f008                      	BRLO	VINRANGE			// YES, CONTINUES TO NEXT STEPS
00018f 27bb                      	CLR		POSV				// NO, LOADS FIRST PAGE
                                 VINRANGE:
000190 dfda                      	RCALL	TWISTART			// STARTS TWI
000191 dfcb                      	RCALL	CFGCOMM				// SETS TWI TO COMMAND MODE
                                 
000192 2fcb                      	MOV		PAYLD,POSV
000193 6bc0                      	ORI		PAYLD,0XB0			// SETS PAGE: B0 + POSV (0xB0 = 0; 0xB7 = 7)
000194 dfe6                      	RCALL	SEND_BYTE
                                 
000195 2fca                      	MOV		PAYLD,POSH			// SELECTS (MASK) HIGHER NIBBLE OF COLUMN ADDRESS
000196 77c0                      	ANDI	PAYLD,0X70
000197 95c2                      	SWAP	PAYLD				// MOVES DATA TO LOWER NIBBLE
000198 61c0                      	ORI		PAYLD,0X10
000199 dfe1                      	RCALL	SEND_BYTE			// SETS HIGHER NIBBLE OF COLUMN ADDRESS
00019a 2fca                      	MOV		PAYLD,POSH			// SELECTS (MASK) LOWER NIBBLE OF COLUMN ADDRESS
00019b 70cf                      	ANDI	PAYLD,0X0F
00019c dfde                      	RCALL	SEND_BYTE			// SETS LOWER NIBBLE OF COLUMN ADDRESS
                                 
00019d dfd7                      	RCALL	TWISTOP				// STOPS TWI
                                 
00019e 91cf                      	POP		PAYLD				// RESTORES REGISTER(S)
00019f 91bf                      	POP		POSV
0001a0 91af                      	POP		POSH
0001a1 9508                      	RET
                                 
                                 // ---------------------------------------------------------------------------------------------------
                                 // SENDS STRING UNTIL ***** EOL / END ***** CHAR IS FOUND
                                 // Z MUST BE POINTING TO STRING DATA
                                 // CURSOR LOCATION MUST BE SET BEFOREHAND, I.E., SET_POS FUNCTION
                                 // VALUE IN TMP WILL BE USED AS DELAY BETWEEN PRINTING CONSECUTIVE CHARS
                                 // DOES NOT CHANGE CONTENT OF REGISTERS
                                 
                                 PRINTSTR:
0001a2 93cf                      	PUSH	PAYLD				// REGISTER(S) BACKUP
0001a3 93bf                      	PUSH	POSV
0001a4 93af                      	PUSH	POSH
0001a5 930f                      	PUSH	TMP
0001a6 93ef                      	PUSH	ZL
0001a7 93ff                      	PUSH	ZH
                                 PRINT_NEXT:
0001a8 37ab                      	CPI		POSH,HLIM6X8+1		// CHECKS IF HOR. POSITION IS WITHIN PRINTABLE RANGE
0001a9 f030                      	BRLO	ST_H_OK				// YES, PROCEEDS W/ PRINTING
0001aa 27aa                      	CLR		POSH				// NO, LINE BREAK: POSH SET TO FIRST COLUMN;
0001ab 95b3                      	INC		POSV				//     POSV SET TO NEXT PAGE;
0001ac 30b8                      	CPI		POSV,VLIM6X8+1		// CHECKS IF VERT. POSITION IS WITHIN PRINTABLE RANGE
0001ad f409                      	BRNE	ST_V_OK				// YES, PROCEEDS W/ PRINTING
0001ae 27bb                      	CLR		POSV				// NO, SCREEN BREAK: POSV SET TO FIRST PAGE
                                 ST_V_OK:
0001af dfd7                      	RCALL	SET_POS				// SETS POSITION
                                 ST_H_OK:
0001b0 d395                      	RCALL	DELAY_DS			// DELAY BEFORE PRINTING EACH CHAR
0001b1 e0c6                      	LDI		PAYLD,6				// UPDATES POSITION "TRACKER"
0001b2 0fac                      	ADD		POSH,PAYLD
0001b3 91c5                      	LPM		PAYLD,Z+			// LOADS NEXT CHAR
0001b4 38c0                      	CPI		PAYLD,CHAR_LIM		// CHECKS IF CHAR WITHIN RANGE
0001b5 f011                      	BREQ	END_PRINT			// NO, FINISHES ROUTINE
0001b6 d026                      	RCALL	CHAR6X8				// YES, PRINTS IT
0001b7 cff0                      	RJMP	PRINT_NEXT
                                 END_PRINT:
0001b8 91ff                      	POP		ZH					// RESTORES REGISTER(S)
0001b9 91ef                      	POP		ZL
0001ba 910f                      	POP		TMP
0001bb 91af                      	POP		POSH
0001bc 91bf                      	POP		POSV
0001bd 91cf                      	POP		PAYLD
0001be 9508                      	RET
                                 
                                 // ---------------------------------------------------------------------------------------------------
                                 // ERASES SCREEN COMPLETELY // SHOWS IMAGE ON SCREEN (Z MUST POINT TO IMAGE DATA)
                                 
                                 CLEAR_SC:
0001bf 930f                      	PUSH	TMP					// REGISTER(S) BACKUP
0001c0 2700                      	CLR		TMP					// TMP = 0 -> CLEARS SCREEN (TRACKS WHAT ROUTINE WAS CALLED)
0001c1 c002                      	RJMP	DUMP_DATA
                                 SHOW_IMAGE:
0001c2 930f                      	PUSH	TMP					// REGISTER(S) BACKUP
0001c3 e001                      	LDI		TMP,1				// TMP = 1 -> SHOWS IMAGE POINTED BY Z (TRACKS WHAT ROUTINE WAS CALLED)
                                 DUMP_DATA:
0001c4 93bf                      	PUSH	POSV				// REGISTER(S) BACKUP
0001c5 93af                      	PUSH	POSH
0001c6 93cf                      	PUSH	PAYLD
                                 
0001c7 e0b0                      	LDI		POSV,0				// LOADS VERTICAL COORDINATE TO FIRST PAGE
0001c8 e0c0                      	LDI		PAYLD,0				// LOADS DATA CORRESPONDING TO "CLEAR SCREEN" (ALL PIXELS OFF)
                                 PAGES:
0001c9 e0a0                      	LDI		POSH,0				// LOADS HORIZONTAL COORDINATE TO FIRST COLUMN
0001ca dfbc                      	RCALL	SET_POS				// SETS POSITION
                                 COLUMNS:
0001cb df9f                      	RCALL	TWISTART			// (RE)STARTS TWI
0001cc df97                      	RCALL	CFGDATA				// SETS TWI TO DATA MODE
0001cd 3000                      	CPI		TMP,0				// CHECKS IF FUNCTION CALLED IS CLEAR_SC (TMP = 0) OR SHOW_IMAGE (TMP = !0)
0001ce f009                      	BREQ	EMPTY_SCREEN		// TMP = 0
0001cf 91c5                      	LPM		PAYLD,Z+			// TMP != 0
                                 EMPTY_SCREEN:
0001d0 dfaa                      	RCALL	SEND_BYTE			// SENDS DATA FROM PAYLD
0001d1 95a3                      	INC		POSH				// INCREMENTS COUNTER TO NEXT COLUMN
0001d2 38a0                      	CPI		POSH,NUM_COL		// CHECKS IF COUNTER REACHED LIMIT (OVER LAST COLUMN)
0001d3 f7b9                      	BRNE	COLUMNS				// NOT YET, SENDS NEXT BYTE (COLUMN)
0001d4 dfa0                      	RCALL	TWISTOP				// 128 BYTES ALREADY SENT, STOPS TWI
                                 
0001d5 95b3                      	INC		POSV				// INCREMENTS COUNTER TO NEXT PAGE
0001d6 30b8                      	CPI		POSV,NUM_PAG		// CHECKS IF COUNTER REACHED LIMIT (OVER LAST PAGE)
0001d7 f789                      	BRNE	PAGES				// NOT YET, SENDS NEXT PAGE
                                 								// 8 PAGES ALREADY SENT, FINISHES ROUTINE
0001d8 91cf                      	POP		PAYLD				// RESTORES REGISTER(S)
0001d9 91af                      	POP		POSH
0001da 91bf                      	POP		POSV
0001db 910f                      	POP		TMP
0001dc 9508                      	RET
                                 		
                                 // ---------------------------------------------------------------------------------------------------
                                 // PRINTS CHAR STORED IN PAYLD
                                 // "CURSOR" LOCATION MUST BE DEFINED, I.E., SET_POS MUST BE CALLED BEFORE USING THIS FUNCTION
                                 
                                 CHAR6X8:
0001dd 93cf                      	PUSH	PAYLD				// REGISTER(S) BACKUP
0001de 930f                      	PUSH	TMP
0001df 93ef                      	PUSH	ZL
0001e0 93ff                      	PUSH	ZH
                                 
0001e1 38c0                      	CPI		PAYLD,CHAR_LIM		// CHECKS IF CHAR IS PRINTABLE (I.E. WITHIN THE RANGE OF PRE-DEFINED CHARS)
0001e2 f008                      	BRLO	CHAR_IN_RANGE
0001e3 c00f                      	RJMP	END_CHAR6X8			// IF NOT, ENDS SUBROUTINE
                                 CHAR_IN_RANGE:
0001e4 df86                      	RCALL	TWISTART			// STARTS TWI
0001e5 df7e                      	RCALL	CFGDATA				// SETS TWI TO DATA MODE
0001e6 e0f4                      	LDI		ZH,HIGH(2*FONT_6X8)	// POINTS Z TO FONT DATA
0001e7 e1e8                      	LDI		ZL,LOW(2*FONT_6X8)
0001e8 e006                      	LDI		TMP,6				// MULTIPLIES CHAR ID BY 6 (6 BYTES PER CHAR)
0001e9 9f0c                      	MUL		TMP,PAYLD
0001ea 0de0                      	ADD		ZL,R0				// POINTS Z TO DATA FOR CORRESPONDING CHAR
0001eb 1df1                      	ADC		ZH,R1
                                 
0001ec e000                      	LDI		TMP,0				// CLEARS COUNTER
                                 NEXT_CHAR_COL:
0001ed 91c5                      	LPM		PAYLD,Z+			// READS DATA BYTE (COLUMN)
0001ee df8c                      	RCALL	SEND_BYTE			// SENDS DATA READ
0001ef 9503                      	INC		TMP					// INCREMENTS COUNTER
0001f0 3006                      	CPI		TMP,6				// CHECKS IF COUNTER REACHED LIMIT
0001f1 f7d9                      	BRNE	NEXT_CHAR_COL		// NOT YET, SENDS NEXT BYTE (COLUMN)
0001f2 df82                      	RCALL	TWISTOP				// 6 BYTES ALREADY SENT, STOPS TWI
                                 END_CHAR6X8:
0001f3 91ff                      	POP		ZH					// RESTORES REGISTER(S)
0001f4 91ef                      	POP		ZL
0001f5 910f                      	POP		TMP
0001f6 91cf                      	POP		PAYLD
0001f7 9508                      	RET
                                 
                                 // ---------------------------------------------------------------------------------------------------
                                 // 
                                 OLED_B:
0001f8 93cf                      	PUSH	PAYLD				// REGISTER(S) BACKUP
                                 	
0001f9 df71                      	RCALL	TWISTART			// STARTS TWI
0001fa df62                      	RCALL	CFGCOMM				// SETS TWI TO COMMAND MODE
0001fb eac7                      	LDI		PAYLD,0XA7			// SENDS COMMAND TO BLACK PIXELS IN WHITE BACKGROUND
0001fc df7e                      	RCALL	SEND_BYTE
0001fd df77                      	RCALL	TWISTOP				// STOPS TWI
                                 	
0001fe 91cf                      	POP		PAYLD				// RESTORES REGISTER(S)
0001ff 9508                      	RET
                                 
                                 // ---------------------------------------------------------------------------------------------------
                                 // 
                                 OLED_W:
000200 93cf                      	PUSH	PAYLD				// REGISTER(S) BACKUP
                                 
000201 df69                      	RCALL	TWISTART			// STARTS TWI
000202 df5a                      	RCALL	CFGCOMM				// SETS TWI TO COMMAND MODE
000203 eac6                      	LDI		PAYLD,0XA6			// SENDS COMMAND TO WHITE PIXELS IN BLACK BACKGROUND
000204 df76                      	RCALL	SEND_BYTE
000205 df6f                      	RCALL	TWISTOP				// STOPS TWI
                                 		
000206 91cf                      	POP		PAYLD				// RESTORES REGISTER(S)
000207 9508                      	RET
                                 
                                 // ---------------------------------------------------------------------------------------------------
                                 // 
                                 
                                 DISP_INI_DATA:		// Initialization Sequence
000208 1020
000209 a1c8
00020a 148d
00020b e3af                      .DB 0x20, 0x10, 0xC8, 0xA1, 0x8D, 0x14, 0xAF, 0xE3 // SHORT CONFIG
                                 
                                 /*	
                                 0xAE,			// Display OFF (sleep mode)
                                 0x20, 0x00,		// Set Memory Addressing Mode: 00=Horizontal Addressing Mode; 01=Vertical Addressing Mode; 10=Page Addressing Mode (RESET); 11=Invalid
                                 0xC8,			// Set COM Output Scan Direction (0xC0 / 0xC8 -> "mirror image")  -> can be ommitted ***
                                 0xA1,			// Set Segment Re-map. A0=column address 0 is mapped to SEG0 (RESET); A1=column address 127 is mapped to SEG0 (upside down)  -> can be ommitted ***
                                 0x8D, 0x14,		// Charge pump setting
                                 0xAF			// Display ON in normal mode
                                 
                                 0x21, 0x00, 0x7F,	// SET COLUMN START AND END FOR HORIZONTAL/VERTICAL ADDRESSING MODES
                                 0x22, 0x00, 0x07	// SET PAGE START AND END FOR HORIZONTAL/VERTICAL ADDRESSING MODES
                                 0xB0,			// Set Page Start Address for Page Addressing Mode, 0-7 -> can be ommitted
                                 0x00,			// ---set low column address -> can be ommitted
                                 0x10,			// ---set high column address -> can be ommitted
                                 0x40,			// --set start line address -> can be ommitted
                                 0x81, 0x80,		// Set contrast control -> can be ommitted
                                 0xA6,			// Set Normal/Inverse D. A6=Normal (white in black); A7=Inverse (black in white) -> can be ommitted
                                 0xA8, 0x3F,		// Set multiplex ratio (default=0x3F) -> can be ommitted
                                 0xA4,			// Output RAM to Display; 0xA4=Output follows RAM content; 0xA5,Output ignores RAM content -> can be ommitted
                                 0xD3, 0x00,		// Set display offset (vertical shift from 0x0 to 0x3F; default=0) -> can be ommitted
                                 0xD5, 0xF0,		// Set Display Clock Divide Ratio/Oscillator frequency -> can be ommitted
                                 0xD9, 0x22,		// Set pre-charge period -> can be ommitted
                                 0xDA, 0x12,		// Set COM pins Hardware Configuration -> can be ommitted	
                                 0xDB, 0x20		// --set vcomh 0x20,0.77xVcc (RESET) -> can be ommitted
                                 */
                                 
                                 
