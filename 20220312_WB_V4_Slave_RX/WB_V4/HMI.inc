// -----------------------------------------------------------------------------------------------
//		ANIMATION
ANIMATION:
IMAGELD:
	LDI		ZH,HIGH(2*IMAGE)			// POINTS Z TO IMAGE DATA
	LDI		ZL,LOW(2*IMAGE)
	RCALL	SHOW_IMAGE
	LDI		TMP,80
	RCALL	DELAY_DS
	RCALL	CLEAR_SC
WIRELESS:
	POS_DEF	2,15
	P_STR	W_STR,10					// PRINTS "WIRELESS" WITH A 10 mS DELAY BETWEEN CHARS
	LDI		TMP,100
	RCALL	DELAY_MS
	P_STR	BL_STR,0					// PRINTS "WIRELESS" WITHOUT DELAY BETWEEN CHARS
INV_PREP:
	LDI		TMP2,7
	LDI		TMP,4
INV_ANIM:
	RCALL	DELAY_DS
	RCALL	OLED_B						// BLACK PIXELS IN WHITE BACKGROUND
	RCALL	DELAY_DS
	RCALL	OLED_W						// WHITE PIXELS IN BLACK BACKGROUND
	MOV		TMP3,TMP					//	TMP = TMP+TMP/2
	LSR		TMP3
	ADD		TMP,TMP3
	DEC		TMP2
	BRNE	INV_ANIM
TRANS_REC:								// PRINT REVISION
	LDI		TMP,50
	RCALL	DELAY_DS
	LDI		POSV,5
	RCALL	SET_POS

	SBRS	FL,MASTER					// CHECKS IF DEVICE IS IN MASTER MODE
	RJMP	SET_ID_STR_S
//	RJMP	SET_ID_STR_M				// LOADS MASTER STRING (LOW = SLAVE, HIGH = MASTER)
SET_ID_STR_M:
	P_STR	V4_M_STR,0					// PRINTS MASTER STRING WITHOUT DELAY BETWEEN CHARS
	RJMP	DEL_ANIM
SET_ID_STR_S:
	P_STR	V4_M_STR,0					// PRINTS SLAVE STRING WITHOUT DELAY BETWEEN CHARS
//	RJMP	DEL_ANIM
DEL_ANIM:
	LDI		TMP,1
	RCALL	DELAY_S
	RCALL	CLEAR_SC
	LDI		TMP,50
	RCALL	DELAY_DS
	RET

// -----------------------------------------------------------------------------------------------
//		SHOWS SCREEN

LOAD_DEF_SCREEN:
	POS_DEF	1,0
	SBRS	FL,MASTER					// CHECKS IF DEVICE IS IN MASTER MODE
	RJMP	LD_S_M
//	RJMP	LD_M_M						// LOADS MASTER STRING (LOW = SLAVE, HIGH = MASTER)
LD_M_M:
	P_STR	MM_STR,0
	POS_DEF	1,110						// IF DEVICE IS IN MASTER MODE, PRINTS "Hz"
	P_CHAR	'H'
	P_CHAR	'z'
	RJMP	DEF_SC_CONTINUE
LD_S_M:
	P_STR	SM_STR,0
//	RJMP	DEF_SC_CONTINUE
DEF_SC_CONTINUE:
	POS_DEF	3,0							// PRINTS DO_STR ON LINE 3, COLUMN 0, WITH 0 DELAY BETWEEN CHARS
	P_STR	DO_STR,0
	POS_DEF	3,64						// PRINTS DO_STR ON LINE 3, COLUMN 64, WITH 0 DELAY BETWEEN CHARS
	P_STR	DI_STR,0
	POS_DEF	4,0							// PRINTS SW_STR ON LINE 4, COLUMN 0, WITH 0 DELAY BETWEEN CHARS
	P_STR	SW_STR,0
	RET

